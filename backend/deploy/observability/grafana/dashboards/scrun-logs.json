{
 "uid": "scrun-logs",
 "title": "SCRUN 로그",
 "tags": [
  "scrun"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "editable": false,
 "description": "계획 0087 3단계. Sentry 오류의 request_id(req_…)를 검색어에 넣으면 그 요청의 모든 서비스 로그. 이 파일이 원본. 검색어에 \" 나 \\ 는 넣지 말 것(쿼리가 깨짐)",
 "templating": {
  "list": [
   {
    "type": "query",
    "name": "service",
    "label": "서비스",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "service",
     "stream": "",
     "type": 1
    },
    "definition": "label_values(service)",
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "type": "textbox",
    "name": "search",
    "label": "검색어 (예: req_…, UNREADABLE, Traceback)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "서비스별 로그 줄 수 (1분)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (count_over_time({service=~\"$service\"} |= \"$search\" [1m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "오류처럼 보이는 줄 (1분)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "description": "error·exception·traceback·\"status\":5xx가 든 줄. 진짜 오류 묶음은 Sentry에서",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (count_over_time({service=~\"$service\"} |~ \"(?i)(error|exception|traceback|\\\"status\\\":5[0-9][0-9])\" |= \"$search\" [1m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 2
  },
  {
   "type": "logs",
   "title": "로그 (위 검색어로 거름, 최신이 위)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 16
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=~\"$service\"} |= \"$search\""
    }
   ],
   "options": {
    "showTime": true,
    "showLabels": false,
    "showCommonLabels": false,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   },
   "id": 3
  },
  {
   "type": "table",
   "title": "느리거나 실패한 요청 (요청 로그 JSON: 5xx 또는 1초 넘음)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 10
   },
   "description": "app/core/request_log.py 한 줄을 칸으로 나눔. rid를 위 검색어에 넣으면 그 요청이 지나간 로그가 다 나옴",
   "targets": [
    {
     "refId": "A",
     "expr": "{service=~\"$service\"} |= \"\\\"rid\\\"\" | json | __error__=\"\" | status >= 500 or ms > 1000",
     "queryType": "range"
    }
   ],
   "transformations": [
    {
     "id": "extractFields",
     "options": {
      "source": "Line",
      "format": "json"
     }
    },
    {
     "id": "organize",
     "options": {
      "includeByName": {
       "Time": true,
       "service": true,
       "rid": true,
       "method": true,
       "path": true,
       "status": true,
       "ms": true,
       "db_ms": true,
       "pool_ms": true,
       "queue_ms": true
      }
     }
    }
   ],
   "options": {
    "showHeader": true
   },
   "id": 4
  }
 ]
}
