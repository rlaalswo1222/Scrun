# 서버에서만 .env로 복사해 채운다. git에 올리지 않는다(공개 저장소).
# 무작위 값 만들기: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# HTTPS 주소. 지금은 sslip.io(IP를 이름으로 바꿔 주는 무료 서비스), 출시 전에 진짜 도메인(BL-51)
SITE_ADDRESS=

# DB 비밀번호(무작위, DB 주소 URL에 그대로 들어가므로 영문·숫자·-·_만. token_urlsafe 값. update.sh가 검사)
DB_PASSWORD=

# 토큰 서명 키(무작위 32자 이상, 로컬 개발용과 다르게)
JWT_SECRET=

# 카카오 모드는 compose에 real로 고정(여기서 못 바꿈)
# 카카오 개발자 > 내 애플리케이션 > 앱 ID(숫자)
KAKAO_APP_ID=
