# 서버에서만 .env로 복사해 채운다. git에 올리지 않는다(공개 저장소).
# 무작위 값 만들기: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# HTTPS 주소. 지금은 sslip.io(IP를 이름으로 바꿔 주는 무료 서비스), 출시 전에 진짜 도메인(BL-51)
SITE_ADDRESS=

# DB 비밀번호(무작위, DB 주소 URL에 그대로 들어가므로 영문·숫자·-·_만. token_urlsafe 값. update.sh가 검사)
DB_PASSWORD=

# 토큰 서명 키(무작위 32자 이상, 로컬 개발용과 다르게)
JWT_SECRET=

# 카카오 모드는 compose에 real로 고정(여기서 못 바꿈)
# 카카오 개발자 > 내 애플리케이션 > 앱 ID(숫자)
KAKAO_APP_ID=
# 카카오 개발자 > 내 애플리케이션 > 앱 키 > 어드민 키(계획 0058: 계정 삭제 때 연결 끊기, 연결 끊기 웹훅 확인).
# 모든 권한을 가진 키라 이 파일 밖(채팅·저장소)에 두지 않는다. 비우면 계정 삭제가 503
KAKAO_ADMIN_KEY=

# 서버 오류를 Sentry로(계획 0087, ADR-0015). Sentry 프로젝트(Python) > Settings > Client Keys (DSN). 비우면 안 보냄
SENTRY_DSN=

# 지표·대시보드(계획 0087 2단계). 둘 다 서버에서 무작위로(채팅·저장소에 안 둠):
#   python3 -c "import secrets; print(secrets.token_urlsafe(36))"
# Grafana 관리자(고칠 때만, 보기는 로그인 없이 SSH 터널로). 확인: grep GRAFANA_ADMIN_PASSWORD .env
GRAFANA_ADMIN_PASSWORD=
# Grafana 알람 → api /internal/alerts → Sentry 메일. Grafana와 api가 같은 값을 씀
ALERT_WEBHOOK_TOKEN=
