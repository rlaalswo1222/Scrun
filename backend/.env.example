# 복사해서 .env로 쓰기(.env는 git에 안 올림). 운영 서버 값은 절대 여기 적지 않는다
DATABASE_URL=postgresql+psycopg://scrun:scrun-local-only@localhost:5432/scrun
TEST_DATABASE_URL=postgresql+psycopg://scrun:scrun-local-only@localhost:5432/scrun_test

# 토큰 서명 키(꼭 있어야 하고 32자 이상, 없으면 서버가 시작하지 않음). 사람마다·서버마다 새로 만들어 넣는다:
#   ../.venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# real(기본): 카카오 API로 확인, KAKAO_APP_ID 필요 / fake: 가짜 카카오(토큰 k_123 → 회원번호 123)
# fake는 아무나 아무 계정으로 로그인되므로 로컬 개발·테스트 전용. 운영 .env엔 절대 넣지 않는다
KAKAO_MODE=fake
# 카카오 개발자 > 내 애플리케이션 > 앱 ID(숫자). real일 때 필요. 다른 앱에서 받은 토큰을 거르는 데 씀
KAKAO_APP_ID=
# 어드민 키(계획 0058). real일 때 계정 삭제(카카오 연결 끊기)·연결 끊기 웹훅에 필요, 없으면 그 둘만 503. fake면 필요 없음
KAKAO_ADMIN_KEY=

# 계기판 사진 OCR(계획 0038·0046). none(기본): 사진 인증은 503 / fake: 파일 이름으로 값을 정하는 가짜(에디터 확인용)
# / onnx: 진짜 엔진(읽기 프로세스 2개, requirements.txt의 onnxruntime·rapidocr, 처음 한 번 PP-OCRv5 모델을 받음)
# (console_d3120_t1080.jpg → 3120 m·1080초, blur → 다시 찍기, unsupported → 읽을 수 없는 계기판). 운영 .env엔 절대 넣지 않는다
OCR_ENGINE=fake
# 인증 판정 값(없으면 app/core/config.py VerificationPolicy 기본값): VERIFY_DISTANCE_TOLERANCE=0.40, VERIFY_DURATION_MIN_S=-30,
# VERIFY_DURATION_MAX_S=300, VERIFY_MAX_PAUSE_S=600, VERIFY_DEADLINE_S=600, VERIFY_MAX_RETAKES=3, VERIFY_OCR_TIMEOUT_S=15

# 페이스 봇(계획 0040). 없으면 기본값: 맵마다 사람 + 봇 = 6, 페이스 9·7.5·10.5·6·12 km/h(빈자리는 앞쪽 페이스부터 채움). 0이면 봇 없음
# BOT_FILL_TO=6
# BOT_PACES_KMH=9,7.5,10.5,6,12

# 틀린 친구 코드 제한(계획 0044). 없으면 기본값: 없는 코드를 10분(600초) 안에 10번 넣으면 그 뒤로 RATE_LIMITED
# FRIEND_ADD_FAIL_LIMIT=10
# FRIEND_ADD_FAIL_WINDOW_S=600
