# 복사해서 .env로 쓰기(.env는 git에 안 올림). 운영 서버 값은 절대 여기 적지 않는다
DATABASE_URL=postgresql+psycopg://scrun:scrun-local-only@localhost:5432/scrun
TEST_DATABASE_URL=postgresql+psycopg://scrun:scrun-local-only@localhost:5432/scrun_test

# 토큰 서명 키(꼭 있어야 하고 32자 이상, 없으면 서버가 시작하지 않음). 사람마다·서버마다 새로 만들어 넣는다:
#   ../.venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# real(기본): 카카오 API로 확인, KAKAO_APP_ID 필요 / fake: 가짜 카카오(토큰 k_123 → 회원번호 123)
# fake는 아무나 아무 계정으로 로그인되므로 로컬 개발·테스트 전용. 운영 .env엔 절대 넣지 않는다
KAKAO_MODE=fake
# 카카오 개발자 > 내 애플리케이션 > 앱 ID(숫자). real일 때 필요. 다른 앱에서 받은 토큰을 거르는 데 씀
KAKAO_APP_ID=
