# 복사해서 .env로 쓰기(.env는 git에 안 올림). 운영 서버 값은 절대 여기 적지 않는다
DATABASE_URL=postgresql+psycopg://scrun:scrun-local-only@localhost:5432/scrun
TEST_DATABASE_URL=postgresql+psycopg://scrun:scrun-local-only@localhost:5432/scrun_test

# 토큰 서명 키. 운영에선 길고 무작위인 값으로(예: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef

# fake: 가짜 카카오(토큰 k_123 → 카카오 회원번호 123) / real: 카카오 API로 확인(카카오 개발자 앱 등록 후)
KAKAO_MODE=fake
