/* 주간 목표 현황(H-07)·변경 시트(H-08), 계획 0054. Figma "SCRUN" > 스크런 와이어 프레임 H 섹션 기준(11/18 읽음).
   Nav Bar는 Onboarding.uss, 시트·칩은 Friends.uss. USS에 없는 것: 카드 그라데이션 → 파랑 한 색 */

.wg .unity-label {
    margin: 0;
    padding: 0;
}

/* ---- 이번 주 카드(파랑) ---- */
.wg-week {
    margin-top: var(--space-3);
    padding: 20px 24px;
    border-radius: 24px;
    background-color: var(--color-primary);
}

.wg .wg-week-label {
    font-size: var(--font-size-caption);
    color: rgba(255, 255, 255, 0.85);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.wg-week-count {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 6px;
}

.wg .wg-done {
    font-size: 52px;
    color: var(--color-surface);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.wg .wg-of {
    margin: 0 0 10px 8px;
    font-size: var(--font-size-sub);
    color: rgba(255, 255, 255, 0.9);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.wg-dots {
    flex-direction: row;
    margin-top: var(--space-2);
}

.wg-dot {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    border-radius: 15px;
    background-color: rgba(255, 255, 255, 0.3);
    align-items: center;
    justify-content: center;
}

.wg-dot--done {
    background-color: var(--color-lime);
}

.wg .wg-dot-mark {
    font-size: var(--font-size-body-sm);
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.wg .wg-next {
    margin-top: var(--space-3);
    font-size: var(--font-size-body-sm);
    color: var(--color-surface);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

/* ---- 흰 카드(목표 없음·최근 8주) ---- */
.wg-card {
    margin-top: var(--space-3);
    padding: 18px 20px;
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 20px;
    background-color: var(--color-surface);
}

.wg-empty {
    align-items: center;
    padding: 28px 20px;
}

.wg .wg-empty-title {
    font-size: var(--font-size-sub);
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.wg .wg-empty-body {
    margin-top: 6px;
    font-size: var(--font-size-body-sm);
    color: var(--color-body);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.wg-bars-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.wg .wg-bars-title {
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

/* 막대 8칸: 같은 너비(1/8), 바닥 맞춤, 아래 이름. 이력이 적어도 "이번"은 늘 오른쪽 끝(Figma H-07) */
.wg-bars {
    flex-direction: row;
    justify-content: flex-end;
    height: 110px;
    margin-top: var(--space-4);
}

.wg-bar-col {
    width: 12.5%;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
}

.wg-bar-track {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: flex-end;
}

.wg-bar {
    width: 26px;
    border-radius: 6px;
    background-color: var(--color-primary-soft);
}

.wg-bar--achieved {
    background-color: var(--color-primary);
}

.wg-bar--current {
    background-color: var(--color-lime);
}

.wg .wg-bar-label {
    margin-top: 6px;
    font-size: var(--font-size-caption);
    color: var(--color-muted);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.wg .wg-legend {
    margin-top: var(--space-3);
    font-size: var(--font-size-caption);
    color: var(--color-muted);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.wg-action {
    flex-shrink: 0;
    margin: var(--space-3) var(--space-5) var(--space-4) var(--space-5);
}

/* ---- H-08 변경 시트 ---- */
.wg .wg-sheet-title {
    margin-top: var(--space-3);
    -unity-text-align: upper-center;
}

.wg-stepper {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-4);
}

.wg-step {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 22px;
    background-color: var(--color-primary-soft);
    font-size: 24px;
    color: var(--color-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.wg-step:hover,
.wg-step:active {
    background-color: var(--color-primary-soft);
}

.wg-step:disabled {
    opacity: 0.4;
}

.wg-step-value {
    flex-direction: row;
    align-items: flex-end;
    width: 110px;
    justify-content: center;
}

.wg .wg-step-number {
    font-size: 48px;
    color: var(--color-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.wg .wg-step-unit {
    margin: 0 0 8px 4px;
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.wg-chips {
    flex-direction: row;
    justify-content: center;
    margin-top: var(--space-3);
}

.wg-chip {
    min-width: 34px;
    height: 30px;
    margin: 0 3px;
    padding: 0 10px;
    border-width: 0;
    border-radius: 15px;
    background-color: var(--color-primary-soft);
    font-size: var(--font-size-caption);
    color: #2459BC;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.wg-chip:hover,
.wg-chip:active {
    background-color: var(--color-primary-soft);
}

.wg-chip--on,
.wg-chip--on:hover,
.wg-chip--on:active {
    background-color: var(--color-primary);
    color: var(--color-surface);
}

.wg .wg-sheet-note {
    margin: var(--space-3) 0 var(--space-2) 0;
    font-size: var(--font-size-body-sm);
    color: var(--color-body);
    -unity-text-align: upper-center;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.wg-sheet-button {
    margin-top: var(--space-2);
}
