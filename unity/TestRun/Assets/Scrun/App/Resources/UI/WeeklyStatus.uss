/* 주간 목표 현황(H-07)·변경 시트(H-08), 계획 0054. 우주 디자인(계획 0068): 상준 미리보기 js/views/my.js weekly·changeSheet를 옮김.
   공통 부품(ui-nav·ui-card·글자 단계)은 Space.uss, 시트·칩은 Friends.uss. 이 USS는 홈(Home.uxml, 목표 정하기 시트)에도 붙으므로 .wg 아래로만.
   USS에 없는 것: 카드 흐림·그림자, 동그라미 안쪽 테 그림자 → 반투명 + 1px 테 */

.wg .unity-label {
    margin: 0;
    padding: 0;
}

/* ---- 이번 주 카드: "이번 주" / 2 / 3회 / 동그라미 30 ---- */
.wg-week {
    margin-top: 4px;
    padding: 20px;
}

.wg-week-count {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 4px;
}

.wg .wg-of {
    margin: 0 0 6px 4px;
}

.wg-dots {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}

.wg-dot {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    border-radius: 15px;
    border-width: 1px;
    border-color: var(--glass-control);
    background-color: var(--glass-well);
}

/* 한 번: 하늘색 + 체크(흰 선 아이콘을 어둡게) */
.wg-dot--done {
    border-width: 0;
    background-color: var(--brand-accent);
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/check-line.svg");
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    -unity-background-image-tint-color: var(--text-on-accent);
}

.wg .wg-dot-mark {
    display: none;
}

.wg .wg-next {
    margin-top: 12px;
}

/* ---- 목표 없음·최근 8주 카드 ---- */
.wg-card {
    margin-top: 12px;
}

.wg-empty {
    margin-top: 4px;
}

.wg .wg-empty-body {
    margin-top: 4px;
}

/* 막대 8칸(높이 120): 같은 너비(1/8), 바닥 맞춤, 아래 이름. 이력이 적어도 "이번"은 늘 오른쪽 끝 */
.wg-bars {
    flex-direction: row;
    justify-content: flex-end;
    height: 120px;
    margin-top: 16px;
}

.wg-bar-col {
    width: 12.5%;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
}

.wg-bar-track {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: flex-end;
}

/* 미달성 = 진한 남색, 달성 = 파랑 + 위에 흰 체크, 이번 주 = 하늘색 */
.wg-bar {
    width: 28px;
    min-height: 8px;
    border-radius: 6px;
    background-color: var(--bg-muted);
}

.wg-bar--achieved {
    background-color: var(--brand-primary);
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/check-line.svg");
    background-size: 20px 20px;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: top 4px;
    -unity-background-image-tint-color: var(--text-on-brand);
}

.wg-bar--current {
    background-color: var(--brand-accent);
}

.wg .wg-bar-label {
    margin-top: 8px;
    font-size: 11px;
    color: var(--text-tertiary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.wg .wg-legend {
    margin-top: 12px;
}

.wg .ui-foot > .btn {
    margin: 0;
}

/* ---- H-08 시트(미리보기 changeSheet): 제목 가운데 / − 숫자 56 + 회 + / 동그란 1–7(40) / 안내 / 저장·취소 ---- */
.wg .wg-sheet-title {
    margin-top: 12px;
    -unity-text-align: upper-center;
}

.wg-stepper {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
}

.wg-step {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: var(--glass-control-edge);
    border-radius: 22px;
    background-color: var(--glass-control);
    font-size: 24px;
    color: var(--text-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.wg-step:hover {
    background-color: var(--glass-control);
}

.wg-step:active {
    scale: 0.96 0.96;
    background-color: var(--glass-pressed);
}

.wg-step:disabled {
    opacity: 0.4;
}

.wg-step-value {
    flex-direction: row;
    align-items: flex-end;
    width: 120px;
    justify-content: center;
}

.wg .wg-step-number {
    font-size: 56px;
    color: var(--text-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-ExtraBold.asset");
}

.wg .wg-step-unit {
    margin: 0 0 8px 4px;
    font-size: 18px;
    color: var(--text-secondary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.wg-chips {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 16px;
}

/* 동그란 알약(미리보기 .pill.round 40) */
.wg-chip {
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: var(--glass-control-edge);
    border-radius: 20px;
    background-color: var(--glass-control);
    font-size: 15px;
    color: var(--text-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.wg-chip:hover {
    background-color: var(--glass-control);
}

.wg-chip:active {
    scale: 0.96 0.96;
}

.wg-chip--on,
.wg-chip--on:hover,
.wg-chip--on:active {
    border-top-width: 0;
    background-color: var(--brand-primary);
    color: var(--text-on-brand);
}

.wg .wg-sheet-note {
    margin-top: 16px;
    font-size: 14px;
    color: var(--text-secondary);
    -unity-text-align: upper-center;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.wg .wg-sheet-button {
    margin-top: 16px;
}

.wg .btn-ghost.wg-sheet-button {
    margin-top: 8px;
}
