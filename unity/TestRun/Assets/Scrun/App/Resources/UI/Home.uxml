<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 홈 B-01–B-04(계획 0057, 모양은 상준 미리보기 home 계획 0068). 프로필 카드(→ H-04) → 큰 문구 → 내 행성 카드(이번 주 진행, 목표 있으면 → H-07)
         → (B-02) 이번 주 목표 정하기 → 달리기 시작 → 지금 달리는 친구(없으면 친구 추가).
         상태 고르기·글자는 HomeText, 채우기는 HomeScreen(GET /v1/home 한 번). 처음 불러오는 동안·실패는 공통 칸 state(계획 0056), 큰 버튼은 그때도 동작.
         I-04 복구 안내창(RecoveryPrompt)도 이 화면 위에 뜬다(모양은 Home.uss) -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/Friends.uss" />
    <!-- 목표 정하기 H-08 시트(WeeklyGoalSheet) 모양 -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/WeeklyStatus.uss" />
    <Style src="project://database/Assets/Scrun/App/Resources/UI/Home.uss" />
    <Style src="project://database/Assets/Scrun/App/Resources/UI/HomeSpace.uss" />
    <ui:VisualElement class="bc hm">
        <ui:ScrollView name="scroll" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="bc-scroll">
            <ui:VisualElement class="bc-page">
                <!-- 공통 상태: 처음 받는 동안 스켈레톤, 실패하면 여기에 -->
                <ui:VisualElement name="state" />

                <ui:VisualElement name="top-part">
                    <!-- 프로필 카드: 얼굴·이름·Lv·러닝복·다음 레벨까지·막대. 누르면 H-04 -->
                    <ui:Button name="level" class="bc-card hs-profile">
                        <ui:VisualElement name="portrait" class="bc-face hs-portrait" picking-mode="Ignore" />
                        <ui:VisualElement class="hs-profile-text" picking-mode="Ignore">
                            <ui:VisualElement class="hs-name-row" picking-mode="Ignore">
                                <ui:Label name="name" class="hs-name" picking-mode="Ignore" />
                                <ui:Label name="level-chip" class="hs-lv" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label name="level-line" class="hs-level-line" picking-mode="Ignore" />
                            <ui:VisualElement name="level-track" class="hs-level-track" picking-mode="Ignore">
                                <ui:VisualElement name="level-fill" class="hs-level-fill" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>

                    <ui:Label name="title" class="bc-title hs-headline" />
                    <ui:Label name="sub" class="bc-sub" />

                    <!-- 내 행성 카드: 왼쪽 위 이번 주 진행(목표가 있을 때). 목표가 있으면 누르면 H-07 -->
                    <ui:VisualElement name="top-card" class="hs-hero">
                        <!-- 목표 달성(B-03): 캐릭터 없는 행성 위 기쁜 포즈(홈 목표 달성 클래스일 때만) -->
                        <ui:VisualElement name="joy" class="hs-joy" picking-mode="Ignore" />
                        <ui:VisualElement name="count-row" class="hs-ring-row" picking-mode="Ignore">
                            <ui:VisualElement name="ring-slot" picking-mode="Ignore" />
                            <ui:Label text="이번 주" class="hs-week" picking-mode="Ignore" />
                            <ui:Label name="done" class="hs-count" picking-mode="Ignore" />
                            <ui:Label text="회" class="hs-week hs-times" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="set-goal" class="bc-ghost" />
                </ui:VisualElement>

                <ui:Button name="start" class="bc-cta" />

                <ui:VisualElement name="bottom-part">
                    <ui:Label name="friends-title" class="bc-section" />
                    <!-- 지금 달리는 친구를 한 줄로 묶음(얼굴 둘 · 이름 · N명 달리는 중 · LIVE) -->
                    <ui:Button name="friends" class="bc-card hs-friend">
                        <ui:VisualElement class="hs-avatars" picking-mode="Ignore">
                            <ui:VisualElement name="avatar-1" class="bc-face hs-avatar" picking-mode="Ignore" />
                            <ui:VisualElement name="avatar-2" class="bc-face hs-avatar hs-avatar--2" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="hs-friend-text" picking-mode="Ignore">
                            <ui:Label name="friends-names" class="hs-friend-title" picking-mode="Ignore" />
                            <ui:Label name="friends-count" class="hs-friend-sub" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="bc-live" picking-mode="Ignore">
                            <ui:VisualElement class="bc-live-dot" picking-mode="Ignore" />
                            <ui:Label text="LIVE" class="bc-live-text" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ui-chev" picking-mode="Ignore" />
                    </ui:Button>
                    <!-- 달리는 친구 0명: 친구 추가(→ G-05), B-04 시안 -->
                    <ui:Button name="friends-empty" class="bc-card hs-friend">
                        <ui:VisualElement class="hs-friend-text" picking-mode="Ignore">
                            <ui:Label name="friends-empty-title" class="hs-friend-title" picking-mode="Ignore" />
                            <ui:Label name="friends-empty-body" class="hs-friend-sub" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ui-chev" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
