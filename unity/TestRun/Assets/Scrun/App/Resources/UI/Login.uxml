<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A-05 로그인(계획 0031, 모양은 상준 미리보기 onboarding.js login, 계획 0068). 실패·취소는 A-19(LoginFailed.uxml, 같은 모양).
         로고·내 행성 그림은 Figma 원본(0061), 그림 칸은 SpaceArt.Fit이 남는 높이에 맞게 줄임 -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/OnboardingSpace.uss" />
    <ui:VisualElement class="ob ui-screen">
        <ui:VisualElement name="fit" class="ob-fit">
            <ui:VisualElement class="ob-art">
                <ui:VisualElement class="ob-img ob-login-logo" />
                <ui:VisualElement class="ob-img ob-login-planet" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ob-login-text">
            <ui:Label text="로그인하고 내 러닝을 시작해요" class="ob-login-head" />
            <!-- 로그인 화면으로 돌아온 이유(예: 다시 로그인해 주세요). 미리보기에 없음, 있을 때만 -->
            <ui:Label name="notice" class="notice-text" />
        </ui:VisualElement>
        <ui:VisualElement class="ui-foot ob-login-foot">
            <!-- 심볼 + 글자를 한 줄로 가운데(버튼 폭이 달라도 겹치지 않게) -->
            <ui:Button name="kakao" class="btn btn-kakao ob-kakao">
                <ui:VisualElement class="ob-kakao-symbol" picking-mode="Ignore" />
                <ui:Label name="kakao-label" text="카카오로 계속하기" class="ob-kakao-label" picking-mode="Ignore" />
            </ui:Button>
            <ui:Label text="로그인 후 약관 동의 단계가 이어져요" class="ob-caption" />
            <!-- 개발 빌드에서만 보임(LoginScreen) -->
            <ui:Button name="dev-native" text="네이티브 점검 (개발 빌드)" class="link-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
