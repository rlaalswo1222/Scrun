<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- H-07 주간 목표 현황(계획 0054, Figma 610:2409). 이번 주 카드(N / M회 · 동그라미 · 예약 줄) → 최근 8주 막대 → 목표 변경(H-08 시트).
         목표가 없으면 빈 카드 + "목표 정하기"(정할 것 1 가). 동그라미·막대·시트는 WeeklyGoalStatusScreen이 코드로.
         모양은 상준 우주 디자인 미리보기(계획 0068, js/views/my.js weekly) -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/Friends.uss" />
    <Style src="project://database/Assets/Scrun/App/Resources/UI/WeeklyStatus.uss" />
    <ui:VisualElement class="fr wg ui-screen">
        <ui:VisualElement class="ui-nav">
            <ui:Button name="back" class="ui-nav-act ui-nav-back" />
            <ui:Label text="주간 목표" class="ui-nav-title" />
            <ui:VisualElement class="fr-nav-space" />
        </ui:VisualElement>
        <ui:ScrollView name="content" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
            <!-- 이번 주 -->
            <ui:VisualElement name="week-card" class="ui-card wg-week">
                <ui:Label text="이번 주" class="ui-cap ui-c2" />
                <ui:VisualElement class="wg-week-count">
                    <ui:Label name="done" class="ui-num-xl wg-done" />
                    <ui:Label name="of" class="ui-sub ui-c2 wg-of" />
                </ui:VisualElement>
                <ui:VisualElement name="dots" class="wg-dots" />
                <ui:Label name="next" class="ui-sm ui-c2 wg-next" />
            </ui:VisualElement>
            <!-- 목표 없음 -->
            <ui:VisualElement name="empty" class="ui-card wg-card wg-empty">
                <ui:Label text="아직 주간 목표가 없어요" class="ui-sub" />
                <ui:Label text="정하면 오늘부터 7일이 한 주예요" class="ui-sm ui-c2 wg-empty-body" />
            </ui:VisualElement>
            <!-- 최근 8주 -->
            <ui:VisualElement name="bars-card" class="ui-card wg-card">
                <ui:VisualElement class="ui-row ui-row--between">
                    <ui:Label text="최근 8주" class="ui-text-strong" />
                    <ui:VisualElement class="fr-chip fr-chip--success">
                        <ui:Label text="7일 주기" class="fr-chip-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="bars" class="wg-bars" />
                <ui:Label text="파랑·체크는 달성, 연한색은 미달성, 하늘색은 이번 주 진행 중" class="ui-cap ui-c3 wg-legend" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="ui-foot">
            <ui:Button name="action" class="btn btn-primary wg-action" />
        </ui:VisualElement>
        <!-- 공통 상태(계획 0056): 첫 로딩 스켈레톤·불러오기 실패 -->
        <ui:VisualElement name="state" />
    </ui:VisualElement>
</ui:UXML>
