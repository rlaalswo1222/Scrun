/* 홈 B-01–B-04(계획 0057) 모양. Figma "SCRUN" > 스크런 와이어 프레임 B 섹션(393×852, 11/19 읽음) 배치를 따르고,
   친구 줄·빈 카드는 Friends.uss(.fr …), 코스 그림은 Course.uss, 목표 동그라미·시트는 WeeklyStatus.uss를 같이 쓴다. 상준이 다듬음.
   위 카드 Figma는 파랑 그라데이션 → USS에 그라데이션이 없어 단색(primary) */

.hm .unity-label {
    margin: 0;
    padding: 0;
}

.hm-scroll {
    flex-grow: 1;
}

.hm-page {
    padding: 8px var(--space-5) var(--space-5) var(--space-5);
}

/* ---- 머리줄: SCRUN · 닉네임 님 ---- */
.hm-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 40px;
}

.hm .hm-logo {
    font-size: 20px;
    letter-spacing: -0.4px;
    color: var(--color-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
    -unity-font-style: italic;
}

.hm .hm-greeting {
    font-size: var(--font-size-body-sm);
    color: var(--color-body);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

/* ---- 위 카드(파랑, 오른쪽 캐릭터) ---- */
.hm-top {
    flex-direction: row;
    min-height: 168px;
    margin-top: var(--space-2);
    padding: 22px 0 18px 22px;
    border-radius: 24px;
    background-color: var(--color-primary);
    overflow: hidden;
}

.hm-top-text {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
}

.hm .hm-kicker {
    font-size: var(--font-size-caption);
    color: rgba(255, 255, 255, 0.8);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.hm .hm-title {
    margin-top: 8px;
    font-size: var(--font-size-heading);
    color: var(--color-surface);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.hm-count-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 6px;
}

.hm .hm-done {
    font-size: 44px;
    color: var(--color-surface);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.hm .hm-of {
    margin: 0 0 8px 6px;
    font-size: var(--font-size-body);
    color: var(--color-surface);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.hm-dots {
    margin-top: 4px;
}

.hm .hm-sub {
    margin-top: 10px;
    font-size: var(--font-size-body-sm);
    color: rgba(255, 255, 255, 0.92);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

/* B-02 "목표 정하기"(흰 칩 버튼) */
.hm-set-goal {
    align-self: flex-start;
    height: 36px;
    margin: 12px 0 0 0;
    padding: 0 16px;
    border-width: 0;
    border-radius: 12px;
    background-color: var(--color-primary-soft);
    font-size: var(--font-size-body-sm);
    color: var(--color-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.hm-set-goal:hover,
.hm-set-goal:active {
    background-color: var(--color-primary-soft);
}

.hm-character {
    width: 118px;
    flex-shrink: 0;
    margin-left: 4px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/CharacterStand.png");
}

.hm-character--run {
    background-image: url("project://database/Assets/Scrun/App/UI/Images/CharacterRun.png");
}

.hm-character--stretch {
    background-image: url("project://database/Assets/Scrun/App/UI/Images/CharacterStretch.png");
}

/* ---- 레벨 줄: Lv 칩(라임) · 글자 · 막대 ---- */
.hm-level {
    flex-direction: row;
    align-items: center;
    height: 58px;
    margin: var(--space-3) 0 0 0;
    padding: 0 16px;
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 18px;
    background-color: var(--color-surface);
    -unity-text-align: upper-left;
}

.hm-level:hover,
.hm-level:active {
    border-color: var(--color-line);
    background-color: var(--color-surface);
}

.hm .hm-level-chip {
    padding: 4px 10px;
    border-radius: 12px;
    background-color: var(--color-lime);
    font-size: var(--font-size-body-sm);
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.hm-level-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 12px;
}

.hm .hm-level-line {
    font-size: var(--font-size-caption);
    color: var(--color-body);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.hm-level-track {
    height: 6px;
    margin-top: 7px;
    border-radius: 3px;
    background-color: var(--color-line);
    overflow: hidden;
}

.hm-level-fill {
    height: 100%;
    width: 0;
    border-radius: 3px;
    background-color: var(--color-lime);
}

.hm-start {
    margin: var(--space-3) 0 0 0;
}

/* ---- 오늘 달릴 코스 ---- */
.hm-section-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-6);
}

.hm .hm-section {
    font-size: var(--font-size-sub);
    letter-spacing: -0.27px;
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.hm .hm-section--friends {
    margin-top: var(--space-6);
}

.hm-see-all {
    margin: 0;
    padding: 4px 0 4px 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: var(--font-size-body-sm);
    color: var(--color-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.hm-see-all:hover,
.hm-see-all:active {
    background-color: rgba(0, 0, 0, 0);
}

.hm-courses {
    flex-direction: row;
    margin-top: var(--space-3);
}

.hm-course {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: stretch;
    margin: 0 10px 0 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 18px;
    background-color: var(--color-surface);
    overflow: hidden;
    -unity-text-align: upper-left;
}

.hm-course--last {
    margin-right: 0;
}

/* 코스가 하나뿐이면 반 칸만(두 칸 자리의 왼쪽) */
.hm-course-spacer {
    flex-grow: 1;
    flex-basis: 0;
}

.hm-course:hover,
.hm-course:active {
    border-color: var(--color-line);
    background-color: var(--color-surface);
}

.hm-course .course-thumb {
    height: 76px;
}

.hm-course .course-thumb-mark {
    font-size: 30px;
}

.hm-course-info {
    padding: 10px 12px 12px 12px;
}

.hm .hm-course-name {
    font-size: var(--font-size-body-sm);
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
    overflow: hidden;
    text-overflow: ellipsis;
}

.hm .hm-course-meta {
    margin-top: 4px;
    font-size: var(--font-size-caption);
    color: var(--color-muted);
    white-space: normal;
}

/* ---- 지금 달리는 친구 없음 ---- */
.hm-friends-empty {
    height: auto;
    padding: 18px 16px 6px 16px;
}

.hm .hm-friends-empty .fr-empty-body {
    -unity-text-align: middle-center;
    white-space: normal;
}

.hm-add-friend {
    height: 36px;
    margin: 12px 0 10px 0;
    padding: 0 18px;
    border-width: 0;
    border-radius: 12px;
    background-color: var(--color-primary-soft);
    font-size: var(--font-size-body-sm);
    color: var(--color-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.hm-add-friend:hover,
.hm-add-friend:active {
    background-color: var(--color-primary-soft);
}

/* ---- I-04 복구 안내창(Figma 611:2252): 홈을 어둡게 덮고 가운데 흰 창 ---- */
.hm-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-night-dim);
}

.hm-dialog {
    width: 84%;
    max-width: 360px;
    padding: 26px 20px 18px 20px;
    border-radius: 24px;
    background-color: var(--color-surface);
}

.hm .hm-dialog-title {
    font-size: var(--font-size-sub);
    color: var(--color-text);
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.hm .hm-dialog-body {
    margin-top: 10px;
    font-size: var(--font-size-body-sm);
    color: var(--color-body);
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.hm-dialog .btn {
    margin: 10px 0 0 0;
}

.hm-dialog .hm-dialog-first {
    margin-top: 22px;
}

