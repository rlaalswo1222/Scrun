/* 홈 I-04 복구 안내(RecoveryPrompt) 모양. 미리보기 home.js recoverSheet(계획 0068): 홈을 어둡게 덮고 아래에서 올라온 시트
   (유리 시트, 위 모서리 28, 제목 22 + 설명 16 + 주 버튼 + 고스트). 홈 화면 자체는 HomeSpace.uss */

.hm .unity-label {
    margin: 0;
    padding: 0;
}

.hm-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: flex-end;
    background-color: var(--bg-overlay);
}

.hm-dialog {
    padding: 28px 20px 34px 20px;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-top-width: 1px;
    border-top-color: var(--glass-edge);
    background-color: var(--glass-sheet);
}

.hm .hm-dialog-title {
    font-size: 22px;
    color: var(--text-primary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.hm .hm-dialog-body {
    margin-top: 16px;
    font-size: 16px;
    color: var(--text-secondary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.hm-dialog .btn {
    margin: 12px 0 0 0;
}

.hm-dialog .hm-dialog-first {
    margin-top: 16px;
}
