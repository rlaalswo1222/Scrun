/* 달리는 중 기본 HUD(가로). 계획 0027. 색·글자 크기는 App.uss 변수. 상준이 Figma D-10·D-11과 맞춰 다듬을 자리 */

.run-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-card {
    position: absolute;
    padding: var(--space-2) var(--space-3);
    border-radius: 14px;
    background-color: var(--color-glass-dark);
}

/* 오른쪽 아래(Figma D-10 배치, 계획 0041) */
.hud-stats {
    right: var(--space-6);
    bottom: var(--space-4);
    min-width: 168px;
}

/* 왼쪽 위 루프 미니맵: 윗줄(코스 이름) 아래 */
.hud-map-card {
    left: var(--space-6);
    top: 40px;
    width: 160px;
    padding: var(--space-2);
    align-items: center;
}

.hud-map {
    width: 144px;
    height: 72px;
}

.course .hud-map-progress {
    font-size: var(--font-size-caption);
    color: var(--color-on-color);
    margin-top: 2px;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

/* 이름표 층 */
.hud-tags {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.course .hud-tag {
    position: absolute;
    flex-direction: row; /* 이름 + Lv 칩(계획 0059) */
    align-items: center;
    translate: -50% -100%;
    font-size: var(--font-size-caption);
    color: var(--color-on-color);
    padding: 3px 8px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.55);
    border-bottom-width: 2px;
    border-bottom-color: var(--color-lime);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.course .hud-tag--bot {
    border-bottom-color: rgba(255, 255, 255, 0.5);
}

/* 러너 정보 카드(D-12) */
.hud-runner-card {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 240px;
    padding: var(--space-4);
    border-radius: 16px;
    background-color: var(--color-surface);
}

.hud-card-head {
    flex-direction: row;
    align-items: center;
}

.course .hud-card-name {
    font-size: var(--font-size-body);
    color: var(--color-text);
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.course .hud-card-badge {
    margin-left: var(--space-2);
    padding: 2px 8px;
    border-radius: 10px;
    font-size: var(--font-size-caption);
    color: #FFFFFF;
    background-color: var(--color-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

/* Lv 칩(Figma D-12 연초록, 계획 0059). 이름표 안 칩은 hud-tag-level */
.course .hud-card-level {
    margin-left: 6px;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: var(--font-size-caption);
    color: var(--color-success);
    background-color: var(--color-success-soft);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.course .hud-tag-name {
    padding: 0;
    margin: 0;
}

.course .hud-tag-level {
    margin: 0 0 0 5px;
    padding: 0 5px;
    border-radius: 6px;
    font-size: 10px;
    color: var(--color-text);
    background-color: var(--color-lime);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.course .hud-card-sub {
    margin-top: 4px;
    font-size: var(--font-size-caption);
    color: var(--color-body);
    white-space: normal;
    padding: 0;
}

.hud-card-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: var(--space-3);
}

.course .hud-card-key {
    font-size: var(--font-size-body-sm);
    color: var(--color-body);
    padding: 0;
}

.course .hud-card-value {
    font-size: var(--font-size-body-sm);
    color: var(--color-text);
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.hud-card-close {
    height: 40px;
    margin: var(--space-4) 0 0 0;
    background-color: var(--color-primary-soft);
    color: #2459BC;
}

.hud-card-close:hover,
.hud-card-close:active {
    background-color: var(--color-primary-soft);
}

.hud-row {
    flex-direction: row;
    align-items: flex-end;
}

.hud-stat {
    flex-direction: row;
    align-items: flex-end;
}

.hud-stat--time {
    margin-left: var(--space-4);
}

.course .hud-big {
    font-size: var(--font-size-heading);
    color: var(--color-on-color);
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.course .hud-unit {
    font-size: var(--font-size-caption);
    color: var(--color-on-color);
    margin: 0 0 3px 2px;
    padding: 0;
}

.hud-goal-bar {
    height: 4px;
    margin-top: 6px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.25);
    overflow: hidden;
}

.hud-goal-fill {
    height: 100%;
    width: 0;
    border-radius: 2px;
    background-color: var(--color-lime);
}

.course .hud-goal-label {
    font-size: var(--font-size-caption);
    color: rgba(255, 255, 255, 0.8);
    margin-top: 4px;
    padding: 0;
}

.hud-gaps {
    left: var(--space-6);
    bottom: var(--space-4);
    min-width: 168px;
}

.hud-gap-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.course .hud-gap-side {
    font-size: var(--font-size-caption);
    color: var(--color-lime);
    width: 18px;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.course .hud-gap-name {
    font-size: var(--font-size-body-sm);
    color: var(--color-on-color);
    flex-grow: 1;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0;
}

.course .hud-gap-value {
    font-size: var(--font-size-body-sm);
    color: var(--color-on-color);
    margin-left: var(--space-3);
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.hud-top-center {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--space-3);
    align-items: center;
}

.course .hud-toast,
.course .hud-net {
    font-size: var(--font-size-body-sm);
    color: var(--color-on-color);
    padding: 6px var(--space-3);
    border-radius: 16px;
    background-color: var(--color-glass-dark);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.course .hud-net {
    margin-top: var(--space-2);
    color: var(--color-warn);
}

/* D-16 끊긴 동안 다른 러너 정보(간격 카드)를 흐리게 */
.course .hud-dimmed {
    opacity: 0.4;
}

/* 개발 빌드만: 위 미니맵 오른쪽 ~ 멈춤 버튼 왼쪽(11/27, 달리며 보이게) */
.course .hud-dev {
    position: absolute;
    left: 196px;
    right: 76px;
    top: 40px;
    -unity-text-align: upper-left;
    font-size: 15px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 12px;
    padding: 8px 12px;
    white-space: normal;
}

/* 고스트(계획 0050): 위 가운데 비교 배너(D-13), 이름표는 하늘색 밑줄(섬 고스트 몸 색과 같은 계열) */
.course .hud-ghost {
    margin-bottom: var(--space-2);
    font-size: var(--font-size-body-sm);
    color: var(--color-text);
    padding: 6px var(--space-3);
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.9);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.course .hud-tag--ghost {
    border-bottom-color: rgb(102, 242, 255);
}
