/* 기록 탭(F-01·F-02, 계획 0053) 모양. Figma "SCRUN" > 스크런 와이어 프레임 F 섹션 기준(11/18 읽음).
   제목·카드(Record Row)·칩·빈 상태 글자는 Friends.uss, 미인증 칩 색은 RunResult.uss를 같이 씀 */

/* 기록이 많아 아래 목록이 길면 제목 줄이 눌려 칩과 겹치던 것(11/18 에디터 캡처) → 제목 줄은 줄지 않게 */
.rc > .fr-header {
    flex-shrink: 0;
}

/* ---- 달 칩: 고른 달은 파랑 바탕·흰 글자, 나머지는 연한 파랑 ---- */
.rc-months {
    flex-direction: row;
    margin-top: var(--space-2);
}

.rc-month {
    height: 28px;
    margin: 0 6px 0 0;
    padding: 0 12px;
    border-width: 0;
    border-radius: 14px;
    background-color: var(--color-primary-soft);
    font-size: var(--font-size-caption);
    color: var(--color-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.rc-month:hover,
.rc-month:active {
    background-color: var(--color-primary-soft);
}

.rc-month--on,
.rc-month--on:hover,
.rc-month--on:active {
    background-color: var(--color-primary);
    color: var(--color-on-color);
}

/* ---- 이번 주 요약 3칸(파란 칸) ---- */
.rc-week {
    flex-direction: row;
    margin-top: var(--space-3);
}

.rc-tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 68px;
    padding: 12px 14px;
    border-radius: 16px;
    background-color: var(--color-primary);
}

.rc-tile--mid {
    margin: 0 var(--space-2);
}

.rc .rc-tile-label {
    font-size: var(--font-size-caption);
    color: rgba(255, 255, 255, 0.85);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.rc .rc-tile-value {
    margin-top: 4px;
    font-size: var(--font-size-sub);
    color: var(--color-on-color);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

/* 기록 카드는 Friends.uss의 Record Row(.fr-record)를 버튼으로 */
.rc-card {
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: upper-left; /* 버튼 기본(가운데)이 안의 글자로 내려가지 않게 */
}

.rc-card:hover,
.rc-card:active {
    background-color: var(--color-surface);
}

/* ---- F-02 빈 상태: 연한 파랑 카드 위 캐릭터(Figma는 앉은 캐릭터, 그림이 오기 전엔 서 있는 캐릭터) ---- */
.rc-illust {
    height: 300px;
    margin-top: var(--space-3);
    border-radius: 20px;
    background-color: var(--color-primary-soft);
    align-items: center;
    justify-content: center;
}

.rc-illust-image {
    width: 110px;
    height: 240px;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/CharacterStand.png");
    -unity-background-scale-mode: scale-to-fit;
}

.rc .rc-center {
    -unity-text-align: upper-center;
}

.rc .rc-empty-title {
    margin-top: var(--space-6);
}
