<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 계기판 인증(계획 0038, Figma E-02·E-04–E-10·I-06). 단계마다 한 칸만 보임(VerifyScreen). E-03 카메라는 Swift(ADR-0011).
         모양은 상준 우주 디자인 미리보기(계획 0068, js/views/verify.js): 공통 부품(ui-*)은 Space.uss, 이 화면만의 것은 Verify.uss -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/Verify.uss" />
    <ui:VisualElement class="vf ui-screen">
        <ui:VisualElement class="ui-nav">
            <ui:VisualElement class="vf-nav-side">
                <ui:Button name="back" class="ui-nav-act ui-nav-back" />
            </ui:VisualElement>
            <ui:Label name="nav-title" text="계기판 인증" class="ui-nav-title" />
            <ui:VisualElement class="vf-nav-side" />
        </ui:VisualElement>

        <!-- E-02 촬영 안내 -->
        <ui:VisualElement name="guide" class="vf-page">
            <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
                <ui:VisualElement class="ui-head">
                    <ui:Label text="계기판을 촬영해 주세요" class="ui-title" />
                    <ui:Label text="방금 달린 거리와 시간이 화면에 보이도록 찍어 주세요" class="ui-text" />
                </ui:VisualElement>
                <ui:VisualElement class="ui-photo vf-sample" />
                <ui:VisualElement class="ui-card vf-tips">
                    <ui:VisualElement class="vf-tip vf-tip--first"><ui:VisualElement class="vf-check" /><ui:Label text="계기판 전체가 보이도록 정면에서 찍어요" class="ui-sm vf-tip-text" /></ui:VisualElement>
                    <ui:VisualElement class="vf-tip"><ui:VisualElement class="vf-check" /><ui:Label text="화면 반사나 흔들림이 없게 찍어요" class="ui-sm vf-tip-text" /></ui:VisualElement>
                    <ui:VisualElement class="vf-tip"><ui:VisualElement class="vf-check" /><ui:Label text="갤러리 사진은 사용할 수 없어요 (앱 카메라만 가능)" class="ui-sm vf-tip-text" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="guide-error" class="ui-sm vf-error" />
            </ui:ScrollView>
            <ui:VisualElement class="ui-foot vf-foot">
                <ui:Button name="open-camera" text="카메라 열기" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- E-04 촬영 확인(사진만, 읽은 값은 보낸 뒤 E-05b에서, 계획 0045) -->
        <ui:VisualElement name="confirm" class="vf-page">
            <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
                <ui:VisualElement class="ui-head">
                    <ui:Label text="이 사진으로 인증할까요?" class="ui-title" />
                    <ui:Label text="숫자가 잘 보이는지 확인해 주세요" class="ui-text" />
                </ui:VisualElement>
                <ui:VisualElement name="photo" class="ui-photo vf-photo" />
                <ui:VisualElement class="ui-card vf-card">
                    <ui:Label text="인식된 값은 수정할 수 없어요. 센서 기록과 그대로 대조해요." class="ui-sm" />
                </ui:VisualElement>
                <ui:Label name="confirm-error" class="ui-sm vf-error" />
            </ui:ScrollView>
            <ui:VisualElement class="ui-foot vf-foot">
                <ui:Button name="send" text="이 사진으로 인증" class="btn btn-primary" />
                <ui:Button name="retake" text="다시 촬영" class="btn btn-ghost" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- E-05 인증 중: 고리(VerifyScreen이 돌림) + 진행 목록 -->
        <ui:VisualElement name="sending" class="vf-page vf-sending">
            <ui:VisualElement class="verify-spinner" />
            <ui:Label text="계기판 수치를 확인하고 있어요" class="ui-heading vf-sending-title" />
            <ui:Label text="잠시만 기다려 주세요" class="ui-text ui-c2 vf-sending-lead" />
            <ui:VisualElement class="ui-card vf-progress">
                <ui:VisualElement class="vf-tip vf-tip--first"><ui:VisualElement class="vf-ring" /><ui:Label text="계기판 수치 읽기" class="ui-text vf-tip-text" /></ui:VisualElement>
                <ui:VisualElement class="vf-tip"><ui:VisualElement class="vf-ring" /><ui:Label text="센서 기록 불러오기" class="ui-text vf-tip-text" /></ui:VisualElement>
                <ui:VisualElement class="vf-tip"><ui:VisualElement class="vf-ring" /><ui:Label text="수치 대조" class="ui-text vf-tip-text" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- E-05b 읽은 값 확인(계획 0045, 모양은 민재 11/18). 판정 전이라 읽은 값만 보여 주고 센서 값·결과는 안 보임.
             값은 고칠 수 없음(BL-17 4번). 사진은 E-04 사진을 그대로(read-photo), 값은 read-distance·read-time에 FormatKm·FormatTime으로.
             뒤로 버튼 없음(맞아요·틀렸어요 중 하나). 틀렸어요는 다시 찍기 횟수를 안 써서 남은 횟수를 적지 않음 -->
        <ui:VisualElement name="read" class="vf-page">
            <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
                <ui:VisualElement class="ui-head">
                    <ui:Label text="계기판 숫자가 맞나요?" class="ui-title" />
                    <ui:Label text="사진 속 숫자와 같은지 확인해 주세요" class="ui-text" />
                </ui:VisualElement>
                <ui:VisualElement name="read-photo" class="ui-photo vf-photo vf-photo--read" />
                <ui:Label text="이렇게 읽었어요" class="ui-sm-strong ui-c2 vf-read-caption" />
                <ui:VisualElement class="ui-card vf-list">
                    <ui:VisualElement class="ui-li ui-li--first">
                        <ui:Label text="거리" class="ui-text ui-c2 ui-grow" />
                        <ui:Label name="read-distance" text="-" class="ui-stat-num" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ui-li">
                        <ui:Label text="시간" class="ui-text ui-c2 ui-grow" />
                        <ui:Label name="read-time" text="-" class="ui-stat-num" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="ui-card vf-card">
                    <ui:Label text="숫자는 고칠 수 없어요. 하나라도 다르면 다시 찍어 주세요." class="ui-sm" />
                </ui:VisualElement>
                <ui:Label name="read-error" class="ui-sm vf-error" />
            </ui:ScrollView>
            <ui:VisualElement class="ui-foot vf-foot">
                <ui:Button name="read-yes" text="맞아요, 인증하기" class="btn btn-primary" />
                <ui:Button name="read-no" text="틀렸어요, 다시 찍기" class="btn btn-secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- E-06–E-10·I-06 결과(내용은 VerifyScreen.RenderResult). 맨 위 그림은 점토 3D 상태(미리보기 st3d)·인증 메달·포즈 -->
        <ui:VisualElement name="result" class="vf-page">
            <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
                <ui:VisualElement class="vf-head">
                    <ui:VisualElement name="result-icon" class="verify-icon" />
                    <ui:Label name="result-title" class="ui-heading vf-result-title" />
                    <ui:Label name="result-lead" class="ui-text ui-c2 vf-result-lead" />
                    <ui:Label name="result-chip" class="ui-chip ui-chip--warn vf-chip" />
                    <ui:Label name="result-error" class="ui-sm vf-error" />
                </ui:VisualElement>
                <ui:VisualElement name="result-body" />
            </ui:ScrollView>
            <ui:VisualElement class="ui-foot vf-foot">
                <ui:Button name="primary" class="btn btn-primary" />
                <ui:Button name="secondary" class="btn btn-ghost" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- E-02에서 뒤로: 인증하지 않고 나가기(미리보기 E-16처럼 안내 위에 아래 시트) -->
        <ui:VisualElement name="leave" class="vf-leave">
            <ui:VisualElement class="ui-scrim" />
            <ui:VisualElement class="ui-sheet vf-sheet">
                <ui:VisualElement class="ui-sheet-handle" />
                <ui:Label text="인증하지 않고 나갈까요?" class="ui-heading" />
                <ui:Label text="이번 기록은 미인증으로 저장되고, 나중에 인증할 수 없어요" class="ui-text ui-c2 vf-sheet-text" />
                <ui:Button name="leave-stay" text="계속 인증하기" class="btn btn-primary" />
                <ui:Button name="leave-save" text="미인증으로 저장" class="btn btn-ghost" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
