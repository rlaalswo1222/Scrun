/* 계기판 인증(계획 0038, Figma E-02·E-04–E-10·I-06). 우주 디자인(계획 0068): 상준 미리보기 js/views/verify.js 화면을 그대로 옮김.
   공통 부품(ui-card·ui-photo·ui-chip·ui-li·ui-stats·글자 단계)은 Space.uss, 여기는 이 화면만의 자리·크기. 색은 App.uss 토큰만.
   USS에 없는 것: 그림 그림자(st3d drop-shadow)·유리 흐림 → 빠짐, 돌아가는 고리 둥근 끝 → 테두리 고리 */

/* 글자 기본 여백 없앰. 한 클래스라 아래 규칙이 덮을 수 있음(이 USS는 이 화면에만 붙음) */
.unity-label {
    margin: 0;
    padding: 0;
}

.vf .ui-chip {
    padding: 0 12px;
    border-radius: 14px;    /* 999는 Unity가 가로·세로 반지름을 따로 줄여 타원이 됨 → 높이의 반 */
}

/* 내비 바 양쪽 칸(뒤로가 숨어도 제목이 가운데) */
/* 공통 부품 보충(Space.uss의 .ui-scroll 안쪽 여백 선택자가 Unity 6 ScrollView 구조(뷰포트가 바로 아래 자식이 아님)에 안 맞아 여기서 채움,
   뒤로 아이콘 nav-back.svg는 어두운 선이라 색을 입혀도 어두움 → 흰 선 아이콘) */
.ui-scroll .unity-scroll-view__content-container {
    padding: 0 20px 24px 20px;
}

.ui-nav-back {
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/chevron-left-line.svg");
}

.vf-nav-side {
    width: 44px;
    height: 44px;
}

.vf-page {
    flex-grow: 1;
}

/* 아래 버튼: 사이 12(미리보기 .foot gap). 주 버튼 60 = 54 + 아래 두께 6 */
.vf-foot {
    padding-top: 0;
}

.vf-foot > .btn {
    margin: 12px 0 0 0;
}

.vf-error {
    margin-top: 12px;
    color: var(--text-error);
}

.vf-card {
    margin-top: 12px;
}

/* ---- E-02 예시 사진(미리보기 console.webp, 위 30% 기준으로 잘라 둔 그림) ---- */
.vf-sample {
    height: 228px;
    margin-top: 20px;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/ConsoleSample.png");
}

/* ---- 팁 목록(E-02·E-07)·진행 목록(E-05): 카드 안 줄 사이 8 ---- */
.vf-tips {
    margin-top: 12px;
}

.vf-tip {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 8px;
}

.vf-tip--first {
    margin-top: 0;
}

.vf-check {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin: 1px 12px 0 0;
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/check-line.svg");
    -unity-background-image-tint-color: var(--text-brand);
    -unity-background-scale-mode: scale-to-fit;
}

.vf-tip-text {
    flex-shrink: 1;
}

/* ---- E-04·E-05b 사진 ---- */
.vf-photo {
    height: 300px;
    margin-top: 20px;
}

.vf-photo--read {
    height: 200px;
}

.verify-photo-img {
    flex-grow: 1;
}

/* ---- E-05 인증 중: 위 120(내비 48 + 72), 고리 140, 제목 위 28, 목록 위 28 ---- */
.vf-sending {
    align-items: center;
    padding: 72px 20px 0 20px;
}

.verify-spinner {
    width: 140px;
    height: 140px;
    border-radius: 70px;
    border-width: 10px;
    border-color: var(--brand-accent);
    border-left-color: var(--bg-subtle);    /* 미리보기는 280/380(약 3/4) 호 → 네 변 중 셋 */
}

.vf-sending-title {
    margin-top: 28px;
    -unity-text-align: upper-center;
}

.vf-sending-lead {
    margin-top: 8px;
    -unity-text-align: upper-center;
}

.vf-progress {
    align-self: stretch;
    margin-top: 28px;
}

.vf-progress .vf-tip {
    align-items: center;
}

.vf-ring {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--brand-accent);
}

/* ---- E-05b 읽은 값: 거리·시간 줄 카드 ---- */
.vf-read-caption {
    margin-top: 16px;
}

.vf-list {
    margin-top: 8px;
    padding: 4px 16px;
}

/* ---- 결과 머리: 상태 그림 + 제목 + 설명 + 남은 시간 칩(가운데) ---- */
.vf-head {
    align-items: center;
}

.verify-icon {
    width: 132px;
    height: 132px;
    margin: -22px 0 -29px 0;    /* 그림 둘레 여백만큼 당김(미리보기 st3d: 크기 × .17, .22) */
    -unity-background-scale-mode: scale-to-fit;
}

.verify-icon--ok {
    width: 170px;
    height: 170px;
    margin: -5px 0 -37px 0;     /* E-06: 위 72(내비 48 + 24) − 170 × .17 */
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/BadgeVerified.png");
}

.verify-icon--warn { background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/StatusWarn.png"); }
.verify-icon--bad { background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/StatusErr.png"); }
.verify-icon--camera { background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/StatusCamera.png"); }

/* E-10 시간 초과: 상태 그림 대신 아쉬운 포즈(미리보기 pose_sad, 위 40, 높이 220) */
.verify-icon--clock {
    width: 147px;
    height: 220px;
    margin: 40px 0 0 0;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/PoseSad.png");
}

.vf-result-title {
    margin-top: 16px;
    -unity-text-align: upper-center;
}

/* E-06 인증 완료·I-06 카메라 권한은 큰 제목(28) */
.vf-result-title--big {
    font-size: 28px;
    margin-top: 20px;
}

.vf-result-lead {
    margin-top: 4px;
    -unity-text-align: upper-center;
}

.vf-chip {
    align-self: center;
    margin-top: 12px;
}

/* ---- E-06 계기판 값 두 칸 ---- */
.vf-stats {
    margin-top: 28px;
}

/* ---- E-07 반사로 숫자가 가려진 예시(미리보기 console_glare.webp) ---- */
.vf-glare {
    height: 136px;
    margin-top: 16px;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/ConsoleGlare.png");
}

/* ---- E-08 대조 표 ---- */
.vf-table {
    margin-top: 20px;
    padding: 8px 12px;
}

.vf-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 6px;
    border-top-width: 1px;
    border-top-color: var(--glass-divider);
}

.vf-row--head,
.vf-row--first {
    border-top-width: 0;
}

.vf-row--head {
    padding: 6px;
}

.vf-row--bad {
    border-radius: 8px;
    background-color: var(--status-error-bg);
}

.vf-cell {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 14px;
    color: var(--text-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.vf-cell--item {
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.vf-row--head .vf-cell {
    font-size: 12px;
    color: var(--text-tertiary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.vf-row--bad .vf-cell--diff {
    color: var(--text-error);
}

.vf-notice {
    margin-top: 12px;
}

.vf-notice-text {
    margin-top: 4px;
}

/* ---- E-09 읽을 수 없는 계기판: 유리 칸 200 안 갸웃하는 포즈 184 ---- */
.vf-ill {
    height: 200px;
    margin-top: 20px;
}

.vf-pose {
    width: 123px;
    height: 184px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/PosePuzzled.png");
}

/* ---- I-06 카메라 권한: 번호 줄 카드 ---- */
.vf-steps {
    margin-top: 20px;
}

.vf-step {
    flex-direction: row;
    align-items: center;
}

.vf-step--next {
    margin-top: 12px;
}

.vf-step-text {
    margin-left: 12px;
}

/* ---- E-02 나가기 확인: 아래 시트(사이 16) ---- */
.vf-leave {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 흐림이 없어 반투명(.94)이면 뒤 글·버튼이 비침 → 같은 색의 불투명 바탕 */
.vf-sheet {
    background-color: var(--bg-surface);
}

.vf-sheet > * {
    margin-top: 16px;
}

.vf-sheet > .ui-sheet-handle {
    margin: 0 0 -4px 0;
}

.vf-sheet > .btn {
    margin: 12px 0 0 0;
}

.vf-sheet-text {
    margin-top: 8px;
}
