<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A-19 로그인 실패(카카오)(Figma 698:2350, 계획 0031). 모양은 미리보기 login(failed), 계획 0068: 로그인과 같은 그림 + 제목 + 빨간 안내 상자.
         취소·오류 → 같은 화면에서 다시 시도. 성공하면 A-18 약관 또는 홈 -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/OnboardingSpace.uss" />
    <ui:VisualElement class="ob ui-screen">
        <ui:VisualElement name="fit" class="ob-fit">
            <ui:VisualElement class="ob-art">
                <ui:VisualElement class="ob-img ob-login-logo" />
                <ui:VisualElement class="ob-img ob-login-planet" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ob-login-text">
            <ui:Label text="로그인하지 못했어요" class="ob-login-head" />
            <ui:VisualElement class="ui-card ui-card--error err-banner">
                <ui:VisualElement class="ob-err-icon" />
                <ui:VisualElement class="ob-row-text">
                    <ui:Label text="카카오 로그인이 취소되었거나 연결에 문제가 있어요" class="ui-sm-strong" />
                    <ui:Label text="네트워크를 확인하고 다시 시도해 주세요" class="ui-sm ui-c2" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ui-foot ob-login-foot">
            <ui:Button name="kakao" text="카카오로 다시 시도" class="btn btn-kakao" />
            <ui:Label text="문제가 계속되면 잠시 후 다시 시도해 주세요" class="ob-caption" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
