<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A-02–A-04 서비스 소개 1–3(Figma 596:59·596:101·596:145, 계획 0031). 한 화면에서 그림·글·점·버튼을 바꾼다(IntroScreen) -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/Onboarding.uss" />
    <Style src="project://database/Assets/Scrun/App/Resources/UI/OnboardingFig.uss" />
    <ui:VisualElement class="onb">
        <ui:VisualElement class="nav-bar">
            <ui:VisualElement class="nav-side" />
            <ui:VisualElement class="nav-side nav-side--right">
                <ui:Button name="skip" text="건너뛰기" class="nav-action" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pager" class="spacer">
            <ui:VisualElement name="illust" class="illust illust--intro intro-run" />
            <ui:VisualElement class="head">
                <ui:Label name="title" text="내 속도로 달려요" class="onb-title" />
                <ui:Label name="lead" text="폰 하나로 속도를 추정해 아바타가 내 속도로 달려요" class="onb-lead" />
            </ui:VisualElement>
            <ui:VisualElement class="spacer" />
        </ui:VisualElement>
        <ui:VisualElement name="dots" class="dots">
            <ui:VisualElement class="dot dot--on" />
            <ui:VisualElement class="dot" />
            <ui:VisualElement class="dot" />
        </ui:VisualElement>
        <ui:Button name="next" text="다음" class="btn btn-primary btn-fig" />
    </ui:VisualElement>
</ui:UXML>
