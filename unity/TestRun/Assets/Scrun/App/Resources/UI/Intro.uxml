<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A-02–A-04 서비스 소개 1–3(우주 시안 883:25·884:26·884:127, 계획 0061). 한 화면에서 장면·글·점·버튼을 바꾼다(IntroScreen).
         장면은 그림 칸(illust)에 붙는 intro-run·intro-together·intro-record 클래스로 고름. A-04 기록 카드·칩은 예시 -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/OnboardingSpace.uss" />
    <ui:VisualElement class="sp">
        <ui:VisualElement class="sp-top">
            <ui:VisualElement />
            <ui:Button name="skip" text="건너뛰기" class="sp-pill" />
        </ui:VisualElement>
        <ui:VisualElement name="pager" class="spacer">
            <ui:VisualElement name="fit" class="sp-fit">
                <ui:VisualElement name="illust" class="sp-art art-intro intro-run">
                    <ui:VisualElement class="scene scene-run">
                        <ui:VisualElement class="sp-img img-intro-run" />
                    </ui:VisualElement>
                    <ui:VisualElement class="scene scene-together">
                        <ui:VisualElement class="sp-img img-intro-together" />
                    </ui:VisualElement>
                    <ui:VisualElement class="scene scene-record">
                        <ui:VisualElement class="sp-img img-intro-stage" />
                        <ui:VisualElement class="sp-card rec-card rec-card--1">
                            <ui:VisualElement class="rec-planet" />
                            <ui:VisualElement class="rec-text">
                                <ui:Label text="2.0 km" class="rec-km" />
                                <ui:Label text="노을 호수 한 바퀴" class="rec-name" />
                            </ui:VisualElement>
                            <ui:Label text="인증 완료" class="rec-ok" />
                        </ui:VisualElement>
                        <ui:VisualElement class="sp-card rec-card rec-card--2">
                            <ui:VisualElement class="rec-planet" />
                            <ui:VisualElement class="rec-text">
                                <ui:Label text="3.1 km" class="rec-km" />
                                <ui:Label text="해안 절벽 순환" class="rec-name" />
                            </ui:VisualElement>
                            <ui:Label text="인증 완료" class="rec-ok" />
                        </ui:VisualElement>
                        <ui:VisualElement class="sp-card rec-card rec-card--3">
                            <ui:VisualElement class="rec-planet" />
                            <ui:VisualElement class="rec-text">
                                <ui:Label text="3.0 km" class="rec-km" />
                                <ui:Label text="거목 협곡 순환" class="rec-name" />
                            </ui:VisualElement>
                            <ui:Label text="인증 완료" class="rec-ok" />
                        </ui:VisualElement>
                        <ui:VisualElement class="sp-img img-intro-flag" />
                        <ui:Label text="이번 주 3/3회" class="sp-chip rec-week" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="intro-text">
                <ui:Label name="title" text="내 속도로 달려요" class="sp-title sp-center" />
                <ui:Label name="lead" text="폰 하나로 속도를 추정해&#10;아바타가 내 속도로 달려요" class="sp-lead sp-center" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="dots" class="sp-dots">
            <ui:VisualElement class="dot dot--on" />
            <ui:VisualElement class="dot" />
            <ui:VisualElement class="dot" />
        </ui:VisualElement>
        <ui:Button name="next" text="다음" class="sp-cta" />
    </ui:VisualElement>
</ui:UXML>
