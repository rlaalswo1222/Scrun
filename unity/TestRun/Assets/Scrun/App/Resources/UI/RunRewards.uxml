<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- E-11 인증 후 반영(계획 0051, Figma 607:1602): 주간 목표 → 레벨(러닝복 전후·경험치 바) → 인증 마크(임팩트) → 운동 결과 보기.
         레벨업이면 바가 다 찬 뒤 3초에 E-13 덮개(699:2357) → 계속하기 → E-12.
         모양은 상준 우주 디자인 미리보기(계획 0068, verify.js reflected·levelUp). 바탕은 축하 그림(RunRewardsScreen.RootClass) -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/RunResult.uss" />
    <ui:VisualElement class="rr ui-screen">
        <ui:VisualElement name="rewards-nav" class="ui-nav">
            <ui:VisualElement class="rr-nav-side" />
            <ui:Label text="인증 완료" class="ui-nav-title" />
            <ui:VisualElement class="rr-nav-side" />
        </ui:VisualElement>
        <ui:VisualElement name="content" class="rr-content">
            <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
                <ui:Label text="기록이 인증됐어요" class="ui-title rr-rewards-title" />

                <ui:VisualElement class="rr-rewards-cards">
                    <ui:VisualElement name="weekly" class="ui-card rr-rewards-card rr-rewards-card--first">
                        <ui:VisualElement class="rr-card-head">
                            <ui:Label text="주간 목표" class="ui-text-strong" />
                            <ui:VisualElement name="weekly-chip" class="fr-chip fr-chip--success">
                                <ui:Label name="weekly-text" class="fr-chip-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="weekly-dots" class="rr-dots" />
                    </ui:VisualElement>

                    <ui:VisualElement class="ui-card rr-rewards-card">
                        <ui:VisualElement class="rr-card-head">
                            <ui:Label text="레벨" class="ui-text-strong" />
                            <ui:Label name="level-line" class="ui-sm-strong ui-ca" />
                        </ui:VisualElement>
                        <ui:VisualElement class="rr-outfits">
                            <ui:VisualElement name="outfit-before" class="rr-outfit">
                                <ui:VisualElement class="rr-outfit-img" />
                                <ui:Label name="outfit-before-name" class="rr-outfit-name" />
                            </ui:VisualElement>
                            <ui:Label name="outfit-arrow" class="rr-arrow" />
                            <ui:VisualElement name="outfit-after" class="ui-card ui-card--sel rr-outfit rr-outfit--now">
                                <ui:VisualElement class="rr-outfit-img" />
                                <ui:Label name="outfit-after-name" class="rr-outfit-name" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="rr-xp-row">
                            <ui:Label name="xp-gain" class="ui-sm ui-c2" />
                            <ui:Label name="xp-next" class="ui-sm ui-c2" />
                        </ui:VisualElement>
                        <ui:VisualElement class="rr-bar">
                            <ui:VisualElement name="xp-fill" class="rr-bar-fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="ui-card rr-rewards-card">
                        <ui:VisualElement class="rr-card-head">
                            <ui:Label text="인증 마크" class="ui-text-strong" />
                            <ui:Label name="marks" class="ui-sm-strong ui-ca" />
                        </ui:VisualElement>
                        <ui:Label name="impact-unlocked" class="ui-sm-strong rr-impact" />
                        <ui:Label name="impact-next" class="ui-sm ui-c2 rr-impact-next" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement class="ui-foot rr-foot">
                <ui:Button name="next" text="운동 결과 보기" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 공통 상태(계획 0056): 받는 동안 스켈레톤, 실패하면 다시 시도·운동 결과 보기 -->
        <ui:VisualElement name="state" />

        <!-- E-13 레벨업(덮개). 러닝복 그림은 BL-34 에셋 전까지 메인 캐릭터(정할 것 2 가) -->
        <ui:VisualElement name="levelup" class="rr-levelup">
            <ui:VisualElement class="rr-levelup-body">
                <ui:Label name="levelup-title" text="LEVEL UP!" class="ui-display rr-levelup-title" />
                <ui:VisualElement name="levelup-levels" class="rr-levelup-levels">
                    <ui:Label name="levelup-before" class="ui-chip rr-levelup-chip" />
                    <ui:VisualElement class="rr-arrow rr-levelup-arrow" />
                    <ui:Label name="levelup-after" class="ui-chip ui-chip--live rr-levelup-chip" />
                </ui:VisualElement>
                <ui:VisualElement name="levelup-stage" class="rr-levelup-stage">
                    <ui:VisualElement class="rr-levelup-halo" />
                    <ui:VisualElement class="rr-levelup-halo rr-levelup-halo--inner" />
                    <ui:VisualElement name="levelup-char" class="rr-levelup-char" />
                </ui:VisualElement>
                <ui:Label name="levelup-outfit" class="ui-heading" />
                <ui:Label text="러닝복이 업그레이드됐어요" class="ui-text ui-c2 rr-levelup-lead" />
                <ui:Label name="levelup-xp" class="ui-sm-strong rr-levelup-xp" />
                <ui:Label name="levelup-impact" class="ui-card ui-sm-strong rr-levelup-impact" />
            </ui:VisualElement>
            <ui:VisualElement class="ui-foot rr-foot rr-levelup-foot">
                <ui:Button name="levelup-continue" text="계속하기" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
