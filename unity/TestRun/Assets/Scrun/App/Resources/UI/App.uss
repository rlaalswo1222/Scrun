/* 앱 공통 스타일. 색·글자 값은 Figma "SCRUN" > 스크런 와이어 프레임 > UI Kit(상준) 기준(11/10).
   화면별 모양은 화면 UXML 옆에 따로 USS를 두고, 색·크기는 이 변수를 쓴다. USS는 그림자·흐림·줄 높이가 없어 그건 뺐다. */
:root {
    --color-bg: #F3F8FF;            /* sky/50 */
    --color-surface: #FFFFFF;       /* white */
    --color-surface-2: #EEF2F9;     /* surface (회색 칩) */
    --color-text: #172036;          /* ink */
    --color-body: #4A5468;          /* body */
    --color-muted: #8A93A6;         /* mute */
    --color-primary: #2F6FE4;       /* sky/700 */
    --color-primary-soft: #DCEBFE;  /* sky/100 */
    --color-line: #E3EAF6;          /* line */
    --color-lime: #D8FF3E;          /* lime (지금 달리는 중·진행) */
    --color-night: #0F1B3D;         /* 가로 맵 화면 바탕 */
    --color-night-dim: rgba(15, 27, 61, 0.5);     /* 맵 위를 어둡게 덮기(I-11) */
    --color-primary-tint: rgba(47, 111, 228, 0.08); /* 파란 안내 바탕 */
    --color-glass-dark: rgba(17, 24, 39, 0.72);    /* 흐린 맵 위 동그란 버튼(D-01 X, D-05·D-06 뒤로) */
    --color-success: #1E8F5A;       /* Chip/Success 글자 */
    --color-success-soft: rgba(43, 182, 115, 0.14); /* Chip/Success 바탕 */
    --color-warn: #FFB020;          /* warn(권한 거부 아이콘 바탕) */

    --font-size-title: 28px;        /* App/Title */
    --font-size-heading: 22px;      /* App/Heading */
    --font-size-sub: 18px;          /* App/Subheading */
    --font-size-body: 16px;         /* App/Body */
    --font-size-body-sm: 14px;      /* App/BodySm */
    --font-size-caption: 12px;      /* App/Caption */
    --font-size-tab: 12px;

    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;

}

.app-root {
    flex-grow: 1;
    background-color: var(--color-bg);
}

/* 맵처럼 뒤의 3D가 보여야 하는 화면(AppScreen.ShowsWorld): 앱 배경을 투명하게 */
.app-root--world {
    background-color: rgba(0, 0, 0, 0);
}

/* 스플래시(A-01, 계획 0030, AppScreen.RootClass): 위 #2F6FE4(sky/700) → 아래 #9CC8FD. USS에 그라데이션이 없어
   세로 그라데이션 그림(4×512)을 늘려 깐다. app-root에 칠해 노치·홈 바 여백까지(화면 USS 규칙은 app-root에 안 닿아 여기 둠) */
.app-root--splash {
    background-color: var(--color-primary); /* 그림을 못 불러와도 위쪽 색. 아이폰 실행 화면 색(AppSceneBuilder.LaunchColor)도 이 값 */
    background-image: url("project://database/Assets/Scrun/App/UI/Images/SplashGradient.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* 우주 시안 홈·코스(계획 0062): 파란 그라데이션 + 성운 빛 + 별. 코스 상세는 위 420이 #10164a(맨 위 코스 그림이 그 색으로 흐려짐) */
.app-root--home {
    background-color: #1E2D7A;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/HomeBg.png");
    -unity-background-scale-mode: scale-and-crop;
}

.app-root--course-detail {
    background-color: #10164A;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/CourseDetailBg.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* 우주 시안 온보딩(계획 0061): 남색 그라데이션 + 흐린 빛 + 별(Figma 880:49를 그림으로). 노치·홈 바까지 */
.app-root--space {
    background-color: #13253A;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/SpaceBg.png");
    -unity-background-scale-mode: scale-and-crop;
}

.safe-area {
    flex-grow: 1;
}

.screen-host {
    flex-grow: 1;
    position: relative;
}

/* 화면 하나(AppScreen.Root)는 screen-host를 꽉 채운다 */
.screen-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen {
    flex-grow: 1;
    padding: var(--space-6) var(--space-4) 0 var(--space-4);
}

.screen-title {
    font-size: var(--font-size-title);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
    color: var(--color-text);
    margin-bottom: var(--space-4);
}

.screen-body {
    flex-grow: 1;
}

.body-text {
    font-size: var(--font-size-body);
    color: var(--color-body);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
    white-space: normal;
}

/* 아래 탭(UI Kit Tab Bar): 아이콘 24 + 글자 12, 고른 탭은 파란 아이콘·굵은 글자.
   높이는 탭 버튼이 정하고, 홈 바 여백은 SafeArea가 탭 바 아래 padding으로 더한다(배경이 화면 끝까지, 11/10 아이폰) */
/* ---- 아래 탭: 우주 시안 Game/Dock(계획 0062, Figma B·C 825:571). 위 24는 고른 탭 받침이 솟는 자리, 막대는 그 아래 72 ---- */
.tab-bar {
    background-color: rgba(0, 0, 0, 0);
}

.dock {
    flex-direction: row;
    height: 96px;
    margin: 0 16px 4px 16px;
}

.dock-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 24px;
    bottom: 0;
    border-width: 1px;
    border-radius: 28px;
    border-color: #56668F;
    background-color: #101A33;
}

.tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 96px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    margin: 0;
    padding: 34px 0 0 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* :hover는 터치 화면에서 마지막으로 누른 탭에 남으므로 색을 안 바꿈(11/10 아이폰) */
.tab:hover,
.tab:active {
    background-color: rgba(0, 0, 0, 0);
}

.tab-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 고른 탭: 받침(60, #223259) 위로 솟고 아이콘 44 */
.tab--selected {
    padding-top: 0;
}

.tab--selected .tab-icon {
    width: 60px;
    height: 60px;
    border-width: 1px;
    border-radius: 30px;
    border-color: #56668F;
    background-color: #223259;
    background-size: 44px 44px;
}

.tab-icon--home { background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/DockHome.png"); }
.tab-icon--friends { background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/DockFriends.png"); }
.tab-icon--records { background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/DockRecords.png"); }
.tab-icon--me { background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/DockMe.png"); }

.tab-label {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 11px;
    color: #CDD5EA;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.tab--selected .tab-label {
    margin-top: 6px;
    font-size: 14px;
    color: #F4F6FB;
}

/* ---- 공통 부품(UI Kit Button: 높이 54, 모서리 16, App/Button 17 SemiBold) ---- */
.btn {
    height: 54px;
    margin: var(--space-4) 0 var(--space-4) 0;
    border-width: 0;
    border-radius: 16px;
    font-size: 17px;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.btn-primary {
    background-color: var(--color-primary);
    color: #FFFFFF;
}

/* 기본 테마의 hover·active 회색을 막음(UI Kit에 눌림 색이 없음) */
.btn-primary:hover,
.btn-primary:active {
    background-color: var(--color-primary);
}

.btn-secondary {
    background-color: var(--color-line);
    color: var(--color-text);
}

/* Button/Ghost: 테두리만 */
.btn-ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1.5px;
    border-color: var(--color-line);
    color: var(--color-body);
}

.btn-ghost:hover,
.btn-ghost:active {
    background-color: rgba(0, 0, 0, 0);
}

/* 카카오 로그인 버튼: 카카오 디자인 가이드 색(배경 #FEE500, 글자 검정 85%) */
.btn-kakao {
    background-color: #FEE500;
    color: rgba(0, 0, 0, 0.85);
}

.btn:disabled {
    opacity: 0.4;
}

.top-bar {
    flex-direction: row;
    height: 44px;
    margin-top: -16px;
    margin-left: -8px;
}

.back-button {
    width: 44px;
    height: 44px;
    font-size: 28px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text);
}

.field-label {
    font-size: 15px;
    color: var(--color-text);
    margin-top: var(--space-4);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.hint-text {
    font-size: 13px;
    color: var(--color-muted);
    white-space: normal;
    margin-top: 2px;
}

.status-text {
    font-size: 13px;
    color: var(--color-primary);
    white-space: normal;
    min-height: 18px;
    margin-top: 4px;
}

.error-text {
    color: #D93025;
}

.notice-text {
    font-size: 14px;
    color: #D93025;
    -unity-text-align: middle-center;
    white-space: normal;
}

.input {
    margin: var(--space-2) 0 0 0;
}

.input > .unity-text-field__input {
    height: 48px;
    font-size: 17px;
    padding: 0 12px;
    border-radius: 10px;
    border-color: var(--color-line);
    background-color: var(--color-surface);
    color: var(--color-text);
}

.field-row {
    flex-direction: row;
}

.field-col {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--space-2);
}

.field-col:last-child {
    margin-right: 0;
}

/* 로그인 */
.login {
    justify-content: flex-end;
    padding-bottom: var(--space-6);
}

.login-hero {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.login-logo {
    font-size: 44px;
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.login-lead {
    font-size: 16px;
    color: var(--color-muted);
    margin-top: var(--space-2);
}

/* 약관 */
.terms-all {
    padding: var(--space-4) 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line);
    font-size: 17px;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.terms-row {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
}

.terms-toggle {
    flex-grow: 1;
    font-size: 15px;
}

.link-button {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-muted);
    font-size: 14px;
}

.empty-state {
    align-items: center;
    padding: var(--space-6) 0;
}

/* 로딩·오류 덮개 */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    justify-content: center;
    align-items: center;
    display: none;
}

.overlay-loading {
    background-color: rgba(255, 255, 255, 0.5);
}

.loading-text {
    font-size: 16px;
    color: var(--color-text);
    padding: 12px 20px;
    border-radius: 12px;
    background-color: var(--color-surface);
}

.dialog {
    width: 86%;
    padding: var(--space-6) var(--space-4) var(--space-2) var(--space-4);
    border-radius: 16px;
    background-color: var(--color-surface);
}

.dialog-title {
    font-size: 19px;
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.dialog-body {
    font-size: 15px;
    color: var(--color-text);
    white-space: normal;
    margin-top: var(--space-2);
}

.dialog-id {
    font-size: 11px;
    color: var(--color-muted);
    margin-top: var(--space-2);
}

.dialog-buttons {
    flex-direction: row;
}

.dialog-buttons > .btn {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--space-2);
}

.dialog-buttons > .btn:last-child {
    margin-right: 0;
}
