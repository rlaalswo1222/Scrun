/* 앱 공통 스타일. 색·크기 값은 임시 — 상준 UI Kit(Figma)이 오면 아래 변수만 바꾼다.
   화면별 모양은 화면 UXML 옆에 따로 USS를 두고, 색·크기는 이 변수를 쓴다. */
:root {
    --color-bg: #F6F5F1;
    --color-surface: #FFFFFF;
    --color-text: #1F2328;
    --color-muted: #6B7280;
    --color-primary: #2F6FDE;
    --color-line: #E3E5E8;

    --font-size-title: 24px;
    --font-size-body: 16px;
    --font-size-tab: 12px;

    --space-2: 8px;
    --space-4: 16px;
    --space-6: 24px;

    --tab-bar-height: 49px; /* 아이폰 기본 탭 바 높이(49pt). 홈 바 여백은 그 아래에 따로 더해짐 */
}

.app-root {
    flex-grow: 1;
    background-color: var(--color-bg);
}

.safe-area {
    flex-grow: 1;
}

.screen-host {
    flex-grow: 1;
    position: relative;
}

/* 화면 하나(AppScreen.Root)는 screen-host를 꽉 채운다 */
.screen-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen {
    flex-grow: 1;
    padding: var(--space-6) var(--space-4) 0 var(--space-4);
}

.screen-title {
    font-size: var(--font-size-title);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
    color: var(--color-text);
    margin-bottom: var(--space-4);
}

.screen-body {
    flex-grow: 1;
}

.body-text {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    white-space: normal;
}

/* 아래 탭. 높이는 탭 버튼이 정하고, 홈 바 여백은 SafeArea가 탭 바 아래 padding으로 더한다(배경이 화면 끝까지) */
.tab-bar {
    flex-direction: row;
    background-color: var(--color-surface);
    border-top-width: 1px;
    border-top-color: var(--color-line);
}

.tab {
    flex-grow: 1;
    flex-basis: 0;
    height: var(--tab-bar-height);
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: var(--font-size-tab);
    color: var(--color-muted);
}

/* 누르는 동안만(:hover는 터치 화면에서 마지막으로 누른 탭에 남음, 11/10 아이폰) */
.tab:active {
    background-color: rgba(0, 0, 0, 0.03);
}

.tab--selected {
    color: var(--color-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

/* ---- 공통 부품(임시 모양, 상준 UI Kit으로 바꿈) ---- */
.btn {
    height: 52px;
    margin: var(--space-4) 0 var(--space-4) 0;
    border-width: 0;
    border-radius: 12px;
    font-size: 17px;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.btn-primary {
    background-color: var(--color-primary);
    color: #FFFFFF;
}

.btn-secondary {
    background-color: var(--color-line);
    color: var(--color-text);
}

/* 카카오 로그인 버튼: 카카오 디자인 가이드 색(배경 #FEE500, 글자 검정 85%) */
.btn-kakao {
    background-color: #FEE500;
    color: rgba(0, 0, 0, 0.85);
}

.btn:disabled {
    opacity: 0.4;
}

.top-bar {
    flex-direction: row;
    height: 44px;
    margin-top: -16px;
    margin-left: -8px;
}

.back-button {
    width: 44px;
    height: 44px;
    font-size: 28px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text);
}

.field-label {
    font-size: 15px;
    color: var(--color-text);
    margin-top: var(--space-4);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.hint-text {
    font-size: 13px;
    color: var(--color-muted);
    white-space: normal;
    margin-top: 2px;
}

.status-text {
    font-size: 13px;
    color: var(--color-primary);
    white-space: normal;
    min-height: 18px;
    margin-top: 4px;
}

.error-text {
    color: #D93025;
}

.notice-text {
    font-size: 14px;
    color: #D93025;
    -unity-text-align: middle-center;
    white-space: normal;
}

.input {
    margin: var(--space-2) 0 0 0;
}

.input > .unity-text-field__input {
    height: 48px;
    font-size: 17px;
    padding: 0 12px;
    border-radius: 10px;
    border-color: var(--color-line);
    background-color: var(--color-surface);
    color: var(--color-text);
}

.field-row {
    flex-direction: row;
}

.field-col {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--space-2);
}

.field-col:last-child {
    margin-right: 0;
}

/* 로그인 */
.login {
    justify-content: flex-end;
    padding-bottom: var(--space-6);
}

.login-hero {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.login-logo {
    font-size: 44px;
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.login-lead {
    font-size: 16px;
    color: var(--color-muted);
    margin-top: var(--space-2);
}

/* 약관 */
.terms-all {
    padding: var(--space-4) 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line);
    font-size: 17px;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.terms-row {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
}

.terms-toggle {
    flex-grow: 1;
    font-size: 15px;
}

.link-button {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-muted);
    font-size: 14px;
}

.empty-state {
    align-items: center;
    padding: var(--space-6) 0;
}

/* 로딩·오류 덮개 */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    justify-content: center;
    align-items: center;
    display: none;
}

.overlay-loading {
    background-color: rgba(255, 255, 255, 0.5);
}

.loading-text {
    font-size: 16px;
    color: var(--color-text);
    padding: 12px 20px;
    border-radius: 12px;
    background-color: var(--color-surface);
}

.dialog {
    width: 86%;
    padding: var(--space-6) var(--space-4) var(--space-2) var(--space-4);
    border-radius: 16px;
    background-color: var(--color-surface);
}

.dialog-title {
    font-size: 19px;
    color: var(--color-text);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.dialog-body {
    font-size: 15px;
    color: var(--color-text);
    white-space: normal;
    margin-top: var(--space-2);
}

.dialog-id {
    font-size: 11px;
    color: var(--color-muted);
    margin-top: var(--space-2);
}

.dialog-buttons {
    flex-direction: row;
}

.dialog-buttons > .btn {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--space-2);
}

.dialog-buttons > .btn:last-child {
    margin-right: 0;
}
