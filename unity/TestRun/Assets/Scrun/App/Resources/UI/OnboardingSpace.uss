/* 온보딩 A-05·A-19 로그인, A-18 약관, A-06 프로필, A-07 권한, I-05 모션 권한 거부, A-09·A-10 이어폰, A-16 주간 목표,
   A-17 완료, A-11 보정 안내(계획 0068). 모양은 상준 미리보기 js/views/onboarding.js·errors.js(permDenied), 공통 부품은 Space.uss(ui-*)·App.uss(btn).
   여기는 화면 틀(.ob)·이 화면들에만 있는 부품. 색은 App.uss 토큰만(반투명은 선형 섞기에 맞춘 토큰).
   예전 0061 우주 시안(sp-*)·밝은 와이어프레임(Onboarding.uss·OnboardingFig.uss)은 이 한 벌로 합침 */

.ob {
    flex-grow: 1;
}

.ob .unity-label {
    margin: 0;
    padding: 0;
}

.ob .ui-scroll .unity-scroll-view__content-container {
    padding: 0 20px 24px 20px;
}

.ob-nav-space {
    width: 44px;
    height: 44px;
}

/* 제목 묶음(미리보기 .head): 위 12, 사이 8 */
.ob .ob-title {
    margin-top: 12px;
}

.ob .ob-lead {
    margin-top: 8px;
    color: var(--text-secondary);
}

.ob .ob-center {
    -unity-text-align: upper-center;
}

/* 본문 첫 묶음은 제목 아래 24 */
.ob .ob-first {
    margin-top: 24px;
}

.ob .ob-gap-12 {
    margin-top: 12px;
}

/* 아래 버튼 자리: 버튼 사이 12(주 버튼은 아래 두께 6이 높이에 포함) */
.ob .ui-foot > .btn {
    margin: 0;
}

.ob .ui-foot > .ob-next {
    margin-top: 12px;
}

.ob .ui-foot > .ob-foot-card {
    margin-bottom: 12px;
}

/* ---- 카드 안 줄(미리보기 .rowx): 아이콘 원 44 + 글 + 칩, 사이 12 ---- */
.ob-row {
    flex-direction: row;
    align-items: center;
}

.ob-row-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 12px;
}

.ob .ob-row-name {
    font-size: 16px;
    color: var(--text-primary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.ob .ob-row-desc {
    font-size: 14px;
    color: var(--text-secondary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

/* 아이콘 원(미리보기 .icirc): 44, bg/subtle, 선 아이콘 24(icon/brand) */
.ob-icirc {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 22px;
    background-color: var(--bg-subtle);
    -unity-background-image-tint-color: var(--icon-brand);
    -unity-background-scale-mode: scale-to-fit;
    background-size: 24px 24px;
}

/* 칩(미리보기 .chip): Label에 붙이므로 .ob .unity-label이 지운 여백을 다시 */
.ob .ob-chip {
    height: 28px;
    padding: 0 12px;
    flex-shrink: 0;
    border-radius: 14px;
    border-top-width: 1px;
    border-top-color: var(--glass-control-edge);
    background-color: var(--glass-control);
    color: var(--text-primary);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

/* 번호 뱃지 + 한 줄(미리보기 .num-badge·.rowx, 카드 안 사이 12) */
.ob-step {
    flex-direction: row;
    align-items: center;
}

.ob-step--next {
    margin-top: 12px;
}

.ob .ob-step-num {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 11px;
    background-color: var(--brand-primary);
    color: var(--text-on-brand);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.ob .ob-step-text {
    flex-shrink: 1;
    margin-left: 12px;
    font-size: 16px;
    color: var(--text-primary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

/* ---- A-05·A-19 로그인: 로고(36.5, 8, 320×180) + 내 행성 그림, 아래 글·카카오 버튼. 그림 칸은 SpaceArt.Fit이 남는 높이에 맞게 줄임 ---- */
.ob-fit {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: visible;
}

.ob-art {
    position: absolute;
    width: 393px;
    height: 500px;
}

.ob-img {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.ob-login-logo {
    left: 36px;
    top: 0;
    width: 320px;
    height: 180px;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/LoginLogo.png");
}

.ob-login-planet {
    left: 0;
    top: 80px;
    width: 393px;
    height: 420px;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/LoginPlanet.png");
}

.ob-login-text {
    flex-shrink: 0;
    padding: 0 20px;
}

.ob .ob-login-head {
    font-size: 22px;
    color: var(--text-primary);
    -unity-text-align: upper-center;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.ob .ob-login-foot {
    padding-top: 24px;
}

/* 카카오 버튼(App.uss .btn-kakao: 56, 모서리 12): 심볼 20 + 사이 8 + 글자를 한 줄로 가운데 */
.ob .ob-kakao {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.ob-kakao-symbol {
    width: 20px;
    height: 18px;
    margin-right: 8px;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/KakaoSymbol.png");
    -unity-background-scale-mode: scale-to-fit;
}

.ob .ob-kakao-label {
    font-size: 17px;
    color: var(--text-on-kakao);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.ob .ob-caption {
    margin-top: 16px;
    font-size: 12px;
    color: var(--text-tertiary);
    -unity-text-align: upper-center;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.ob .notice-text {
    margin-top: 8px;
    color: var(--text-warn);
}

.ob .link-button {
    margin: 4px 0 0 0;
    color: var(--text-tertiary);
}

/* A-19 오류 상자(미리보기 .card.errorbox): 빨간 원 28 안 i + 글 둘. 또 실패하면 잠깐 테두리(err-banner--again, LoginScreen) */
.ob .err-banner {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-top-color: var(--glass-control-edge);
    transition-property: border-color;
    transition-duration: 0.15s;
}

.ob .err-banner--again {
    border-color: var(--border-error);
}

.ob-err-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 14px;
    background-color: var(--status-error-solid);
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/info-line.svg");
    -unity-background-image-tint-color: var(--text-on-status);
    -unity-background-scale-mode: scale-to-fit;
    background-size: 18px 18px;
}

/* ---- A-18 약관: 카드 둘(전체 동의, 항목), 안쪽 위아래 4·좌우 16 ---- */
.ob .ob-terms-card {
    padding: 4px 16px;
}

.ob .ob-terms-list {
    margin-top: 12px;
}

.agree-all,
.agree-row {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
}

.agree-row--next {
    margin-top: 0;
}

.agree-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 12px;
    padding: 6px 0;
}

.ob .agree-all-text {
    flex-grow: 1;
    margin-left: 12px;
    font-size: 16px;
    color: var(--text-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.ob .agree-title {
    font-size: 14px;
    color: var(--text-primary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.ob .agree-detail {
    font-size: 12px;
    color: var(--text-tertiary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.ob .agree-view {
    min-height: 44px;
    margin: 0;
    padding: 0 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-brand);
    font-size: 14px;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.ob .agree-view:hover,
.ob .agree-view:active {
    background-color: rgba(0, 0, 0, 0);
}

/* 체크(미리보기 .chk .box): 동그라미 24, 테 1.5 strong, 고르면 파란 원 + 흰 체크 16 */
.check {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: var(--border-strong);
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.check--on {
    border-width: 0;
    background-color: var(--brand-primary);
}

.check-mark {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/check-line.svg");
    -unity-background-image-tint-color: var(--text-on-brand);
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- A-06 프로필 입력칸(미리보기 .fld·.inp, H-11 프로필 편집과 같은 모양) ---- */
.ob .fig-label {
    margin-top: 16px;
    font-size: 14px;
    color: var(--text-secondary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.ob .ob-field-first {
    margin-top: 24px;
}

.ob .fig-field {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin-top: 8px;
    padding: 0 16px 0 4px;
    border-width: 1px;
    border-color: var(--glass-control);
    border-radius: 16px;
    background-color: var(--glass-well);
}

.ob .fig-field--focus {
    border-width: 1.5px;
    border-color: var(--border-focus);
}

.ob .fig-field > .unity-text-field {
    flex-grow: 1;
    margin: 0;
}

.ob .fig-field .unity-text-field__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 16px;
    color: var(--text-primary);
    --unity-cursor-color: var(--brand-accent);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.ob .fig-field .unity-base-text-field__input--placeholder {
    color: var(--text-tertiary);
}

.ob .fig-unit {
    margin-left: 8px;
    font-size: 16px;
    color: var(--text-tertiary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.ob .fig-status {
    margin-top: 8px;
    font-size: 13px;
    color: var(--text-brand);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.ob .fig-status.error-text {
    color: var(--text-error);
}

/* ---- A-07 권한: 카드(안쪽 14·16) 사이 12, 아이콘 원 + 이름·설명 + 칩(필수·허용됨·꺼짐 / 선택은 글자만) ---- */
.ob .perm-list {
    margin-top: 24px;
}

.ob .perm-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 14px 16px;
}

.perm-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 22px;
    background-color: var(--bg-subtle);
    -unity-background-image-tint-color: var(--icon-brand);
    -unity-background-scale-mode: scale-to-fit;
    background-size: 24px 24px;
}

.perm-motion { background-image: url("project://database/Assets/Scrun/App/UI/Icons/activity-line.svg"); }
.perm-headphone { background-image: url("project://database/Assets/Scrun/App/UI/Icons/headphones-line.svg"); }
.perm-camera { background-image: url("project://database/Assets/Scrun/App/UI/Icons/camera-line.svg"); }
.perm-bell { background-image: url("project://database/Assets/Scrun/App/UI/Icons/bell-line.svg"); }

.perm-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 12px;
}

.ob .perm-name {
    font-size: 16px;
    color: var(--text-primary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.ob .perm-desc {
    font-size: 14px;
    color: var(--text-secondary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

/* 필수: 유리 칩 / 허용됨: 초록 칩 / 선택(아직 안 물음): 글자만 / 꺼짐: 노란 칩 */
.ob .perm-chip {
    height: 28px;
    padding: 0 12px;
    flex-shrink: 0;
    border-radius: 14px;
    border-top-width: 1px;
    border-top-color: var(--glass-control-edge);
    background-color: var(--glass-control);
    color: var(--text-primary);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.ob .perm-chip--off {
    padding: 0 4px;
    border-top-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-tertiary);
}

.ob .perm-chip--ok {
    border-top-width: 0;
    background-color: var(--status-success-bg);
    color: var(--text-success);
}

.ob .perm-chip--denied {
    padding: 0 12px;
    border-top-width: 0;
    background-color: var(--status-warn-bg);
    color: var(--text-warn);
}

/* ---- I-05 권한 거부(미리보기 permDenied): 가운데 상태 3D + 제목 + 설명 + 번호 카드 ---- */
.ob .ob-st3d {
    margin-top: -8px;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/StatusSensor.png");
}

.ob .ob-denied-title {
    margin-top: 16px;
    -unity-text-align: upper-center;
}

.ob .ob-denied-lead {
    margin-top: 8px;
    color: var(--text-secondary);
    -unity-text-align: upper-center;
}

.ob .ob-steps-card {
    margin-top: 20px;
}

/* ---- A-09·A-10 이어폰: 그림 칸 200 + 이어폰 카드 ---- */
.ob .ob-ill {
    height: 200px;
    margin-top: 24px;
}

.ob-ill-img {
    width: 100%;
    height: 200px;
    -unity-background-scale-mode: scale-to-fit;
}

.ob-earbuds {
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/GuideEarbuds.png");
}

.ob-treadmill {
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/GuideTreadmill.png");
}

.ob .ob-ill--short {
    height: 180px;
}

.ob-ill--short .ob-ill-img {
    height: 180px;
}

.info-icon {
    width: 44px;
    height: 44px;
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/headphones-line.svg");
    -unity-background-image-tint-color: var(--icon-brand);
    -unity-background-scale-mode: scale-to-fit;
    background-size: 24px 24px;
}

.info-icon-box--off .info-icon {
    -unity-background-image-tint-color: var(--icon-muted);
}

.ob .tag--success {
    border-top-width: 0;
    background-color: var(--status-success-bg);
    color: var(--text-success);
}

.ob .tag--gray {
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: var(--bg-muted);
    color: var(--text-secondary);
}

/* ---- A-16 주간 목표: 카드(안쪽 24·20) 안에 −/큰 숫자 72/+, 7일 궤도 ---- */
.ob .goal-card {
    margin-top: 24px;
    padding: 24px 20px;
    align-items: stretch;
}

.stepper {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* −/+ : 알약 둥근 모양(미리보기 .pill.round 40 → 누르기 좋게 48) */
.ob .step-btn {
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0 0 2px 0;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: var(--glass-control-edge);
    border-radius: 24px;
    background-color: var(--glass-control);
    color: var(--text-primary);
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.ob .step-btn:hover {
    background-color: var(--glass-control);
}

.ob .step-btn:active {
    background-color: var(--glass-pressed);
    scale: 0.96 0.96;
}

.ob .step-btn:disabled {
    background-color: var(--glass-control);
    color: var(--text-disabled);
}

.goal-value {
    flex-direction: row;
    align-items: flex-end;
}

.ob .goal-number {
    font-size: 72px;
    color: var(--text-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-ExtraBold.asset");
}

.ob .goal-unit {
    margin: 0 0 14px 8px;
    font-size: 18px;
    color: var(--text-secondary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.ob .week-label {
    margin-top: 16px;
    font-size: 14px;
    color: var(--text-secondary);
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

/* 7일 궤도: 선 위 점 7개, 오늘(1일)만 하늘색 */
.week {
    height: 50px;
    margin-top: 10px;
}

.week-track {
    position: absolute;
    left: 13px;
    right: 13px;
    top: 11px;
    height: 4px;
    border-radius: 2px;
    background-color: var(--bg-track);
}

.week-days {
    flex-direction: row;
    justify-content: space-between;
}

.week-day {
    width: 26px;
    align-items: center;
}

.week-dot {
    width: 18px;
    height: 18px;
    margin-top: 4px;
    border-width: 1.5px;
    border-radius: 9px;
    border-color: var(--border-strong);
    background-color: var(--bg-muted);
}

.week-day--today .week-dot {
    width: 26px;
    height: 26px;
    margin-top: 0;
    border-width: 0;
    border-radius: 13px;
    background-color: var(--brand-accent);
}

.ob .week-day-label {
    margin-top: 6px;
    font-size: 12px;
    color: var(--text-tertiary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.ob .week-day--today .week-day-label {
    margin-top: 2px;
    color: var(--text-primary);
}

.ob .goal-note {
    margin-top: 12px;
    font-size: 12px;
    color: var(--text-tertiary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

/* ---- A-17 완료(축하 바탕): 제목 28 위 28, 우주인 그림이 남는 자리를 채움 ---- */
.ob .done-title {
    margin-top: 28px;
    -unity-text-align: upper-center;
}

.ob .done-lead {
    margin-top: 8px;
    color: var(--text-secondary);
    -unity-text-align: upper-center;
}

.ob-done-art {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 16px 20px;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/AstroReady.png");
    -unity-background-scale-mode: scale-to-fit;
}

.ob .done-info {
    padding: 14px;
}

.ob .done-info-text {
    font-size: 14px;
    color: var(--text-primary);
    -unity-text-align: upper-center;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

/* ---- A-11 보정 안내: 단계 줄(번호 뱃지)·속도 칩(실제 사다리)·안내 ---- */
.ob .quest {
    margin-top: 12px;
}

.quest-step {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.ob .quest-num {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 11px;
    background-color: var(--brand-primary);
    color: var(--text-on-brand);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.ob .quest-text {
    flex-shrink: 1;
    margin-left: 12px;
    font-size: 16px;
    color: var(--text-primary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.quest-chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.ob .sp-chip {
    height: 28px;
    margin-right: 8px;
    padding: 0 12px;
    border-radius: 14px;
    border-top-width: 1px;
    border-top-color: var(--glass-control-edge);
    background-color: var(--glass-control);
    color: var(--text-primary);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.ob .quest-times {
    font-size: 12px;
    color: var(--text-secondary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.ob .calib-note {
    margin-top: 12px;
    font-size: 13px;
    color: var(--text-tertiary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}
