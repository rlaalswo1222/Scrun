<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A-06 프로필 입력(Figma 596:232, 계획 0031, 모양은 미리보기 profile 계획 0068): 닉네임·키·몸무게 → 가입. 셋 다 맞게 채워야 "다음" -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/OnboardingSpace.uss" />
    <ui:VisualElement class="ob ui-screen">
        <ui:VisualElement class="ui-nav">
            <ui:Button name="back" class="ui-nav-act ui-nav-back" />
            <ui:Label text="프로필" class="ui-nav-title" />
            <ui:VisualElement class="ob-nav-space" />
        </ui:VisualElement>
        <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
            <ui:Label text="나를 알려주세요" class="ui-title ob-title" />
            <!-- 사실대로(계획 0031 정할 것 2): 지금은 서버에 저장만 하고 속도·아바타엔 안 씀. 상준과 문구 확정 -->
            <ui:Label name="lead" class="ui-text ob-lead" />

            <ui:Label text="닉네임 (친구에게 보여요)" class="fig-label ob-field-first" />
            <ui:VisualElement name="nickname-box" class="fig-field">
                <ui:TextField name="nickname" />
            </ui:VisualElement>
            <ui:Label name="nickname-status" class="fig-status" />

            <ui:Label text="키" class="fig-label" />
            <ui:VisualElement name="height-box" class="fig-field">
                <ui:TextField name="height" />
                <ui:Label text="cm" class="fig-unit" />
            </ui:VisualElement>

            <ui:Label text="몸무게" class="fig-label" />
            <ui:VisualElement name="weight-box" class="fig-field">
                <ui:TextField name="weight" />
                <ui:Label text="kg" class="fig-unit" />
            </ui:VisualElement>
            <ui:Label name="body-status" class="fig-status error-text" />
        </ui:ScrollView>
        <ui:VisualElement class="ui-foot">
            <ui:Button name="submit" text="다음" class="btn btn-primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
