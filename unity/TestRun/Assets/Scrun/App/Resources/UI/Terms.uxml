<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A-18 약관·개인정보 동의(Figma 698:2233, 계획 0031, 모양은 미리보기 terms 계획 0068). 목록은 서버 약관(GET /v1/agreements)으로 채움(TermsScreen) -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/OnboardingSpace.uss" />
    <ui:VisualElement class="ob ui-screen">
        <ui:VisualElement class="ui-nav">
            <ui:Button name="back" class="ui-nav-act ui-nav-back" />
            <ui:Label text="약관 동의" class="ui-nav-title" />
            <ui:VisualElement class="ob-nav-space" />
        </ui:VisualElement>
        <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
            <ui:Label text="약관에 동의해 주세요" class="ui-title ob-title" />
            <ui:Label text="SCRUN을 시작하기 전에 확인해 주세요" class="ui-text ob-lead" />
            <ui:VisualElement name="all" class="ui-card ob-terms-card ob-first">
                <ui:VisualElement class="agree-all">
                    <ui:VisualElement name="all-check" class="check">
                        <ui:VisualElement class="check-mark" />
                    </ui:VisualElement>
                    <ui:Label text="전체 동의하기" class="agree-all-text" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="list" class="ui-card ob-terms-card ob-terms-list" />
            <!-- 공통 상태(계획 0056): 받는 동안 스켈레톤, 실패하면 여기에 -->
            <ui:VisualElement name="state" />
        </ui:ScrollView>
        <ui:VisualElement class="ui-foot">
            <ui:Button name="next" text="동의하고 계속하기" class="btn btn-primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
