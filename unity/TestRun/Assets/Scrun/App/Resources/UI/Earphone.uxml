<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A-09 이어폰 미연결·A-10 연결됨(모양은 미리보기 earbuds, 계획 0068). 끼고 빼면 저절로 바뀜 -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/OnboardingSpace.uss" />
    <ui:VisualElement class="ob ui-screen">
        <ui:VisualElement class="ui-nav">
            <ui:Button name="back" class="ui-nav-act ui-nav-back" />
            <ui:Label text="이어폰 연결" class="ui-nav-title" />
            <ui:Button name="skip" text="건너뛰기" class="ui-nav-act ui-nav-act--text" />
        </ui:VisualElement>
        <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
            <ui:Label name="title" class="ui-title ob-title" />
            <ui:Label name="lead" class="ui-text ob-lead" />
            <ui:VisualElement class="ui-ill ob-ill" picking-mode="Ignore">
                <ui:VisualElement class="ob-ill-img ob-earbuds" />
            </ui:VisualElement>
            <ui:VisualElement class="ui-card ob-row ob-gap-12">
                <ui:VisualElement name="icon-box" class="ob-icirc">
                    <ui:VisualElement name="icon" class="info-icon" />
                </ui:VisualElement>
                <ui:VisualElement class="ob-row-text">
                    <ui:Label name="device" class="ob-row-name" />
                    <ui:Label name="detail" class="ob-row-desc" />
                </ui:VisualElement>
                <ui:Label name="chip" class="ob-chip" />
            </ui:VisualElement>
        </ui:ScrollView>
        <!-- 미연결: 연결 확인하기 + 이어폰 없이 계속 / 연결됨: 다음 -->
        <ui:VisualElement class="ui-foot">
            <ui:Button name="check" text="연결 확인하기" class="btn btn-primary" />
            <ui:Button name="without" text="이어폰 없이 계속" class="btn btn-ghost ob-next" />
            <ui:Button name="next" text="다음" class="btn btn-primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
