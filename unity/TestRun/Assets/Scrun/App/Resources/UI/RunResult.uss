/* 운동 결과(E-12·E-14)·기록 상세(F-03·F-04)·인증 후 반영(E-11)·레벨업(E-13)·종료 요약(E-01)·대조 시트(E-15)(계획 0051·0053·0057).
   우주 디자인(계획 0068): 상준 미리보기 js/views/verify.js(result·reflected·levelUp·summary·compareSheet)·records.js(recordDetail)를 옮김.
   공통 부품(ui-card·ui-stats·ui-nav·글자 단계)은 Space.uss, 여기는 이 화면들만의 자리와, 코드가 만드는 칩·머리·시트(FriendParts)의 모양.
   이 USS는 이 화면들(RunResult·RunRewards·RunRecovered·Records)에만 붙음. 색은 App.uss 토큰만.
   USS에 없는 것: 유리 흐림·카드 그림자·글로우(고른 러닝복 카드 빛) → 반투명 + 테두리, 레벨업 색종이 → 빠짐 */

/* 글자 기본 여백 없앰. 한 클래스라 아래 규칙이 덮을 수 있음 */
.unity-label {
    margin: 0;
    padding: 0;
}

.rr .ui-chip {
    padding: 0 12px;
    border-radius: 14px;    /* 999는 Unity가 가로·세로 반지름을 따로 줄여 타원이 됨 → 높이의 반 */
}

/* 공통 부품 보충(Space.uss의 .ui-scroll 안쪽 여백 선택자가 Unity 6 ScrollView 구조(뷰포트가 바로 아래 자식이 아님)에 안 맞아 여기서 채움,
   뒤로 아이콘 nav-back.svg는 어두운 선이라 색을 입혀도 어두움 → 흰 선 아이콘) */
.ui-scroll .unity-scroll-view__content-container {
    padding: 0 20px 24px 20px;
}

.ui-nav-back {
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/chevron-left-line.svg");
}

/* 내비 바 양쪽 칸(뒤로·닫기가 숨어도 제목이 가운데) */
.rr-nav-side {
    flex-direction: row;
    align-items: center;
    min-width: 44px;
    height: 44px;
}

.rr-nav-side--right {
    justify-content: flex-end;
}

.rr-content {
    flex-grow: 1;
}

/* 아래 버튼: 사이 12(미리보기 .foot gap) */
.rr-foot {
    padding-top: 0;
}

.rr-foot > .btn {
    margin: 12px 0 0 0;
}

/* 카드끼리 사이 12 */
.rr-stats,
.rr-graph-card,
.rr-share,
.rr-note,
.rr-link {
    margin-top: 12px;
}

/* ---- 칩(코드가 FriendParts.Chip으로 만듦): 유리 · 인증 완료 초록 · 미인증 주황(미리보기 .chip) ---- */
.fr-chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 28px;
    padding: 0 12px;
    border-radius: 14px;
    border-top-width: 1px;
    border-top-color: var(--glass-control-edge);
    background-color: var(--glass-control);
}

.fr-chip-text {
    font-size: 12px;
    color: var(--text-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.fr-chip--success,
.rr-chip--warn {
    border-top-width: 0;
}

.fr-chip--success { background-color: var(--status-success-bg); }
.fr-chip--success > .fr-chip-text { color: var(--text-success); }
.rr-chip--warn { background-color: var(--status-warn-bg); }
.rr-chip--warn > .fr-chip-text { color: var(--text-warn); }

/* ---- E-12 위: 날짜 + 인증 칩 ---- */
.rr-top {
    margin-top: 4px;
}

/* ---- 거리(60) + 함께 달린 러너 ---- */
.rr-hero {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    padding: 20px;
}

.rr-distance {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 1;
}

.rr-km {
    font-size: 60px;
}

.rr-unit {
    margin: 0 0 9px 4px;
    font-size: 18px;
}

.rr-companions {
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.rr-heads {
    flex-direction: row;
    margin: 8px 0;
}

/* 함께 달린 러너 머리(FriendParts.Head): 바탕색 테두리로 겹침 */
.fr-head {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--bg-app);
    background-color: var(--bg-subtle);
    align-items: center;
    justify-content: center;
}

.fr-head-mark {
    font-size: 13px;
    color: var(--text-brand);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

/* 두 번째 머리부터 겹침(UI Toolkit은 :first-child를 몰라서 코드가 붙임) */
.rr-head--overlap {
    margin-left: -8px;
}

.rr-companion-line {
    -unity-text-align: upper-center;
}

/* ---- 속도 변화 ---- */
.rr-graph-card {
    padding: 12px 16px;
}

.rr-graph {
    height: 64px;
    margin-top: 6px;
}

/* ---- 친구 피드에 공유(카드 전체가 버튼) ---- */
.rr-share {
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: upper-left;
}

.rr-share:hover,
.rr-share:active {
    border-color: var(--glass-stroke);
    border-top-color: var(--glass-edge);
    background-color: var(--glass-fill);
}

/* 토글(미리보기 .tg 51×31) */
.my-switch {
    width: 51px;
    height: 31px;
    flex-shrink: 0;
    margin-left: 12px;
    border-radius: 16px;
    background-color: var(--bg-track);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.my-knob {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 27px;
    height: 27px;
    border-radius: 14px;
    background-color: var(--bg-inverse);
    transition-property: translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.my-switch--on {
    background-color: var(--brand-primary);
}

.my-switch--on > .my-knob {
    translate: 20px 0;
}

/* ---- 미인증·오프라인 안내(주황 유리) ---- */
.rr-note {
    padding: 16px;    /* 글자 여백 없앰(.unity-label)이 ui-card 여백을 덮어서 다시 */
    white-space: normal;
}

/* ---- 대조 자세히(E-15): 누르는 카드 + › ---- */
.rr-link {
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

.rr-link:hover {
    border-color: var(--glass-stroke);
    border-top-color: var(--glass-edge);
    background-color: var(--glass-fill);
}

.rr-chev {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/chevron-right-line.svg");
    -unity-background-image-tint-color: var(--icon-muted);
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- E-15 시트(FriendParts.Sheet): 유리 시트, 사이 16, 표는 카드 ---- */
.fr-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: flex-end;
    background-color: var(--bg-overlay);
}

.fr-sheet {
    padding: 12px 20px 34px 20px;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-top-width: 1px;
    border-top-color: var(--glass-edge);
    background-color: var(--bg-surface);    /* glass/sheet(.94)는 흐림 없이 뒤가 비쳐 같은 색 불투명으로 */
}

.fr-grabber {
    align-self: center;
    width: 36px;
    height: 5px;
    border-radius: 3px;
    background-color: var(--glass-edge);
}

.fr-sheet-title {
    margin-top: 12px;
    font-size: 18px;
    color: var(--text-primary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Bold.asset");
}

.fr-sheet-info {
    margin-top: 16px;
    font-size: 12px;
    color: var(--text-tertiary);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.fr-sheet > .btn {
    margin: 16px 0 0 0;
}

.rr-compare {
    margin-top: 16px;
    padding: 8px 12px;
}

.rr-compare-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 6px;
    border-top-width: 1px;
    border-top-color: var(--glass-divider);
}

.rr-compare-row--head,
.rr-compare-row--first {
    border-top-width: 0;
}

.rr-compare-row--head {
    padding: 6px;
}

.rr-compare-cell {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 14px;
    color: var(--text-primary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.rr-compare-cell--item {
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-SemiBold.asset");
}

.rr-compare-row--head > .rr-compare-cell {
    font-size: 12px;
    color: var(--text-tertiary);
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

/* ---- E-01 종료 요약(복구한 러닝): 위 48, 큰 거리 72 카드(가운데), 세 칸, 카메라 경고 카드 ---- */
.rr-summary-card {
    align-items: center;
    margin-top: 24px;
    padding: 20px;
}

.rr-summary-card > .rr-distance {
    margin-top: 4px;
}

.rr-summary-km {
    font-size: 72px;
}

.rr-summary-unit {
    margin: 0 0 12px 4px;
    font-size: 20px;
}

/* 카메라 아이콘은 글자 칸의 바탕 그림으로(라벨에 자식을 넣으면 글자 높이를 못 잼) */
.rr-warning {
    margin-top: 12px;
    padding: 16px 16px 16px 52px;
    white-space: normal;
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/camera-line.svg");
    background-position-x: left 16px;
    background-position-y: top 16px;
    background-size: 24px 24px;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--text-brand);
}

/* ---- E-11 인증 후 반영: 카드 셋(사이 12), 머리 줄(제목 + 칩·강조 글) ---- */
.rr-rewards-title {
    margin-top: 0;
}

.rr-rewards-cards {
    margin-top: 20px;
}

.rr-rewards-card {
    margin-top: 12px;
}

.rr-rewards-card--first {
    margin-top: 0;
}

.rr-card-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* 주간 목표 동그라미 30(한 것은 하늘색 + 체크, 남은 것은 어두운 홈) */
.rr-dots {
    flex-direction: row;
    margin-top: 12px;
}

.rr-dot {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    border-radius: 15px;
    border-width: 1px;
    border-color: var(--glass-control);
    background-color: var(--glass-well);
    align-items: center;
    justify-content: center;
}

.rr-dot--done {
    border-width: 0;
    background-color: var(--brand-accent);
}

.rr-dot-check {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/check-line.svg");
    -unity-background-image-tint-color: var(--text-on-accent);
    -unity-background-scale-mode: scale-to-fit;
}

/* 러닝복 전 → 후(얼굴 56, 지금 것은 고른 카드) */
.rr-outfits {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 16px 0;
}

.rr-outfit {
    align-items: center;
}

.rr-outfit--now {
    padding: 12px;
}

.rr-outfit-img {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: var(--bg-subtle);
    background-image: url("project://database/Assets/Scrun/App/UI/Images/Space/Face.png");
    -unity-background-scale-mode: scale-and-crop;
}

.rr-outfit-name {
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-secondary);
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Scrun/App/UI/Fonts/Pretendard-Medium.asset");
}

.rr-outfit--now > .rr-outfit-name {
    color: var(--text-primary);
}

.rr-arrow {
    width: 24px;
    height: 24px;
    margin: 0 16px;
    background-image: url("project://database/Assets/Scrun/App/UI/Icons/arrow-right-line.svg");
    -unity-background-image-tint-color: var(--text-primary);
    -unity-background-scale-mode: scale-to-fit;
}

.rr-xp-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.rr-bar {
    height: 8px;
    margin-top: 8px;
    border-radius: 4px;
    background-color: var(--bg-track);
    overflow: hidden;
}

.rr-bar-fill {
    height: 100%;
    width: 0;
    border-radius: 4px;
    background-color: var(--reward-xp);
}

.rr-impact {
    margin-top: 12px;
}

.rr-impact-next {
    margin-top: 2px;
}

/* ---- E-13 레벨업(덮개: 축하 바탕은 앱 바탕이 칠하고, 뒤 카드는 코드가 숨김) ---- */
.rr-levelup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding-top: 20px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.rr-levelup--in {
    opacity: 1;
}

.rr-levelup-body {
    flex-grow: 1;
    align-items: center;
    padding: 0 20px;
}

.rr-levelup-title {
    font-size: 44px;
}

.rr-levelup-levels {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.rr-levelup-chip {
    height: 36px;
    border-radius: 18px;
    padding: 0 16px;
    font-size: 15px;
}

.rr-levelup-arrow {
    margin: 0 12px;
}

/* 캐릭터 뒤 동그라미 둘(280 · 210) */
.rr-levelup-stage {
    width: 300px;
    height: 300px;
    margin-top: 8px;
    align-items: center;
    justify-content: center;
}

.rr-levelup-halo {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 280px;
    height: 280px;
    border-radius: 140px;
    background-color: rgba(255, 255, 255, 0.025); /* Figma .1, 선형 섞기(App.uss 유리 주석) */
}

.rr-levelup-halo--inner {
    left: 45px;
    top: 45px;
    width: 210px;
    height: 210px;
    border-radius: 105px;
    background-color: rgba(255, 255, 255, 0.045); /* Figma .16 */
}

.rr-levelup-char {
    width: 200px;
    height: 280px;
    background-image: url("project://database/Assets/Scrun/App/UI/Images/CharacterRun.png");
    -unity-background-scale-mode: scale-to-fit;
}

.rr-levelup-lead {
    margin-top: 0;
}

.rr-levelup-xp {
    margin-top: 12px;
    -unity-text-align: upper-center;
}

.rr-levelup-impact {
    align-self: stretch;
    margin-top: 12px;
    padding: 12px 16px;
}

.rr-levelup-foot {
    align-self: stretch;
}
