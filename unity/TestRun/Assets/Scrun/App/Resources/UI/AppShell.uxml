<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 앱 전체 틀: 화면 자리(screen-host) + 아래 탭 4개 + 로딩·오류 덮개(Feedback). AppRoot가 띄우고 Navigator가 화면을 바꾼다 -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/App.uss" />
    <ui:VisualElement name="app-root" class="app-root">
        <ui:VisualElement name="safe-area" class="safe-area">
            <ui:VisualElement name="screen-host" class="screen-host" />
            <!-- 아래 탭: Figma UI Kit "Tab Bar"(아이콘 + 글자, 홈·친구·기록·마이 순서) -->
            <ui:VisualElement name="tab-bar" class="tab-bar">
                <ui:Button name="tab-home" class="tab">
                    <ui:VisualElement class="tab-icon tab-icon--home" picking-mode="Ignore" />
                    <ui:Label text="홈" class="tab-label" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="tab-friends" class="tab">
                    <ui:VisualElement class="tab-icon tab-icon--friends" picking-mode="Ignore" />
                    <ui:Label text="친구" class="tab-label" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="tab-records" class="tab">
                    <ui:VisualElement class="tab-icon tab-icon--records" picking-mode="Ignore" />
                    <ui:Label text="기록" class="tab-label" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="tab-me" class="tab">
                    <ui:VisualElement class="tab-icon tab-icon--me" picking-mode="Ignore" />
                    <ui:Label text="마이" class="tab-label" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- I-07 로딩: 서버를 기다리는 동안 화면을 덮어 두 번 누르기를 막음 -->
        <ui:VisualElement name="loading" class="overlay overlay-loading">
            <ui:Label text="잠시만요" class="loading-text" />
        </ui:VisualElement>

        <!-- I-08·I-09 오류·네트워크 -->
        <ui:VisualElement name="error" class="overlay">
            <ui:VisualElement class="dialog">
                <ui:Label name="error-title" class="dialog-title" />
                <ui:Label name="error-body" class="dialog-body" />
                <ui:Label name="error-id" class="dialog-id" />
                <ui:VisualElement class="dialog-buttons">
                    <ui:Button name="error-close" text="닫기" class="btn btn-secondary" />
                    <ui:Button name="error-retry" text="다시 시도" class="btn btn-primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
