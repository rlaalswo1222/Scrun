<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- H-11 프로필 편집(계획 0049, Figma 700:2476): 닉네임·키·몸무게 → PATCH /users/me. 닉네임 확인은 가입(A-06)과 같은 규칙.
         모양은 상준 우주 디자인 미리보기(계획 0068, js/views/onboarding.js profile 편집 모드) -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/My.uss" />
    <ui:VisualElement class="my ui-screen">
        <ui:VisualElement class="ui-nav">
            <ui:Button name="back" class="ui-nav-act ui-nav-back" />
            <ui:Label text="프로필 편집" class="ui-nav-title" />
            <ui:VisualElement class="fr-nav-space" />
        </ui:VisualElement>
        <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
            <ui:Label text="프로필 편집" class="ui-title my-head-title" />
            <ui:Label name="lead" class="ui-text ui-c2 my-lead" />

            <ui:Label text="닉네임 (친구에게 보여요)" class="fig-label my-field-first" />
            <ui:VisualElement name="nickname-box" class="fig-field">
                <ui:TextField name="nickname" />
            </ui:VisualElement>
            <ui:Label name="nickname-status" class="fig-status" />

            <ui:Label text="키" class="fig-label" />
            <ui:VisualElement name="height-box" class="fig-field">
                <ui:TextField name="height" />
                <ui:Label text="cm" class="fig-unit" />
            </ui:VisualElement>

            <ui:Label text="몸무게" class="fig-label" />
            <ui:VisualElement name="weight-box" class="fig-field">
                <ui:TextField name="weight" />
                <ui:Label text="kg" class="fig-unit" />
            </ui:VisualElement>
            <ui:Label name="body-status" class="fig-status error-text" />

            <ui:VisualElement class="ui-card my-notice">
                <ui:Label name="recal-title" class="ui-text-strong" />
                <ui:Label name="recal-body" class="ui-sm ui-c2 my-notice-body" />
                <ui:Button name="recalibrate" text="재보정하기 →" class="my-link" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="ui-foot">
            <ui:Button name="submit" text="저장" class="btn btn-primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
