<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A-16 주간 목표 설정(계획 0031, 모양은 미리보기 goalSet 계획 0068). 카드 안 큰 숫자 + −/+ 단계(주 1–7회)·7일 궤도는 코드가 채움(WeeklyGoalScreen).
         미리보기는 1–7 동그라미 알약이지만 앱은 −/+ 단계와 7일 궤도를 그대로 둠(기능 유지) -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/OnboardingSpace.uss" />
    <ui:VisualElement class="ob ui-screen">
        <ui:VisualElement class="ui-nav">
            <ui:Button name="back" class="ui-nav-act ui-nav-back" />
            <ui:Button name="skip" text="건너뛰기" class="ui-nav-act ui-nav-act--text" />
        </ui:VisualElement>
        <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
            <ui:Label text="한 주에 몇 번&#10;달릴까요?" class="ui-title ob-title" />
            <ui:Label text="매일 달리지 않아도 괜찮아요. 내 일정에 맞게 정해요" class="ui-text ob-lead" />
            <ui:VisualElement class="ui-card goal-card">
                <ui:VisualElement class="stepper">
                    <ui:Button name="minus" text="−" class="step-btn" />
                    <ui:VisualElement class="goal-value">
                        <ui:Label name="count" text="3" class="goal-number" />
                        <ui:Label text="회 / 주" class="goal-unit" />
                    </ui:VisualElement>
                    <ui:Button name="plus" text="+" class="step-btn" />
                </ui:VisualElement>
                <ui:Label text="한 주 (7일)" class="week-label" />
                <ui:VisualElement class="week">
                    <ui:VisualElement class="week-track" />
                    <ui:VisualElement name="days" class="week-days" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="목표를 정한 날부터 7일이 한 주예요. 목표는 마이에서 언제든 바꿀 수 있고, 변경은 이번 주가 끝난 뒤부터 적용돼요." class="goal-note" />
        </ui:ScrollView>
        <ui:VisualElement class="ui-foot">
            <ui:Button name="save" text="목표 정하기" class="btn btn-primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
