<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- E-01 종료 요약·인증 전(계획 0052·0057, Figma 607:1054): I-04 "복구하고 인증하기"로 마무리한 러닝.
         러닝 종료 · 수고했어요! · 안내 · 오늘의 러닝(큰 거리) · 시간·평균 페이스·목표 · 미인증 경고 · 계기판 인증하기 / 미인증으로 저장.
         뒤로 가기 없음: 버튼으로만(D-22와 같음). 모양은 상준 우주 디자인 미리보기(계획 0068, verify.js summary), 카드·칸은 RunResult.uss -->
    <Style src="project://database/Assets/Scrun/App/Resources/UI/RunResult.uss" />
    <ui:VisualElement class="rr ui-screen">
        <ui:VisualElement class="ui-nav">
            <ui:VisualElement class="rr-nav-side" />
            <ui:Label name="nav-title" class="ui-nav-title" />
            <ui:VisualElement class="rr-nav-side" />
        </ui:VisualElement>
        <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="ui-scroll">
            <ui:VisualElement class="ui-head">
                <ui:Label name="title" class="ui-title" />
                <ui:Label name="lead" class="ui-text" />
            </ui:VisualElement>
            <ui:VisualElement class="ui-card rr-summary-card">
                <ui:Label name="card-title" class="ui-sm ui-c2" />
                <ui:VisualElement class="rr-distance">
                    <ui:Label name="km" class="ui-num-xl rr-summary-km" />
                    <ui:Label text="km" class="ui-unit rr-summary-unit" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="ui-stats rr-stats">
                <ui:VisualElement class="ui-stat ui-stat--first">
                    <ui:Label text="시간" class="ui-stat-key" />
                    <ui:Label name="time" class="ui-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="ui-stat">
                    <ui:Label text="평균 페이스" class="ui-stat-key" />
                    <ui:Label name="pace" class="ui-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="ui-stat">
                    <ui:Label text="목표" class="ui-stat-key" />
                    <ui:Label name="goal" class="ui-stat-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="warning" class="ui-card ui-sm rr-warning" />
        </ui:ScrollView>
        <ui:VisualElement class="ui-foot rr-foot">
            <ui:Button name="verify" class="btn btn-primary" />
            <ui:Button name="skip" class="btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
